import { Colors } from "../colors.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { InfoCard } from "../components/cards.slint";
import { PrimaryActionButton, SecondaryActionButton } from "../components/action-buttons.slint";
import { ActionGroup } from "../components/list-and-action-layouts.slint";

export component ActivityProgressPage inherits CenteredPageRoot {
    in property <string> id;
    in property <string> title;
    in property <string> phase;
    in property <string> summary;
    in property <string> items;
    in property <string> bytes;
    in property <string> path;
    in property <float> fraction;
    in property <int> percent;
    callback dismiss();
    callback request-cancel(string, string);

    HeadingLabel {
        text: "Progress: " + root.title;
    }
    SectionHeadingLabel {
        accessible-live-region: polite;
        text: root.phase;
    }
    DescriptionLabel {
        text: root.summary;
    }
    InfoCard {
        accessible-role: region;
        accessible-label: "Overall progress: " + root.percent + " percent. " + root.items + ". " + root.bytes;
        baseline-height: 150px;
        SectionHeadingLabel {
            text: "Overall progress";
        }
        Rectangle {
            background: Colors.progress-track;
            border-radius: 6px;
            height: 12px;
            Rectangle {
                background: Colors.success;
                border-radius: 6px;
                width: parent.width * root.fraction;
                height: parent.height;
            }
        }
        DescriptionLabel {
            text: root.percent + "% complete";
        }
        DescriptionLabel {
            text: root.items;
        }
        DescriptionLabel {
            text: root.bytes;
        }
        SectionHeadingLabel {
            text: "Current item";
        }
        DescriptionLabel {
            text: root.path;
        }
    }
    DescriptionLabel {
        text: "Minimize leaves this operation running. You can return from Activity at any time.";
    }
    ActionGroup {
        SecondaryActionButton {
            accessible-label: "Minimize progress for " + root.title;
            text: "Minimize";
            clicked => {
                root.dismiss();
            }
        }
        PrimaryActionButton {
            accessible-label: "Cancel " + root.title;
            text: "Cancel";
            clicked => {
                root.request-cancel(root.id, root.title);
            }
        }
    }
}
