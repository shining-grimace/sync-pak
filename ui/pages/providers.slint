import {
    Button,
    ListView,
} from "std-widgets.slint";
import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { ProviderRow } from "../models.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { ErrorHeadingLabel } from "../components/error-heading-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";

export component ProvidersPage inherits CenteredPageRoot {
    in property <[ProviderRow]> providers;
    in property <bool> load-failed;
    callback show-providers();
    callback show-add-provider();
    callback verify-saved-provider(string);
    callback request-provider-edit(string);
    callback request-provider-delete(string);

    HeadingLabel {
        text: "Providers";
    }

    DescriptionLabel {
        text: "Provider credentials are kept in this device's protected storage.";
    }

    if root.load-failed: VerticalLayout {
        accessible-role: region;
        accessible-label: "Providers unavailable";
        spacing: 8px;
        ErrorHeadingLabel {
            text: "Providers unavailable";
            color: Colors.danger;
        }

        ErrorLabel {
            text: "SyncPak could not load providers. Check configuration storage and try again.";
        }

        Button {
            accessible-label: "Retry loading providers";
            text: "Retry";
            primary: true;
            clicked => {
                root.show-providers();
            }
        }
    }
    if !root.load-failed: VerticalLayout {
        spacing: 12px;
        Button {
            accessible-label: "Add a provider";
            text: "Add provider";
            height: Dimensions.control-height;
            primary: true;
            clicked => {
                root.show-add-provider();
            }
        }

        if root.providers.length == 0: VerticalLayout {
            spacing: 8px;
            SectionHeadingLabel {
                text: "No providers yet";
            }

            DescriptionLabel {
                text: "Add credentials for Cloudflare R2, Backblaze B2, or AWS S3.";
            }
        }
        if root.providers.length > 0: ListView {
            accessible-label: "Configured providers";
            height: 260px;
            vertical-scrollbar-policy: always-on;
            for provider in root.providers: Rectangle {
                accessible-role: list-item;
                accessible-label: provider.name + ". " + provider.kind + ". " + provider.verification + ". " + provider.connection-summary;
                background: Colors.surface;
                border-color: Colors.border;
                border-width: 1px;
                border-radius: 8px;
                min-height: root.width < Dimensions.narrow-layout-breakpoint ? 168px : 82px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        SectionHeadingLabel {
                            text: provider.name;
                        }

                        DescriptionLabel {
                            text: provider.kind + " · " + provider.verification;
                        }

                        DescriptionLabel {
                            text: provider.connection-summary;
                        }
                    }

                    if root.width < Dimensions.narrow-layout-breakpoint: VerticalLayout {
                        spacing: 8px;
                        Button {
                            accessible-label: "Verify provider " + provider.name;
                            text: provider.verifying ? "Verifying…" : "Verify";
                            enabled: !provider.verifying;
                            clicked => {
                                root.verify-saved-provider(provider.id);
                            }
                        }

                        Button {
                            accessible-label: "Edit provider " + provider.name;
                            text: "Edit";
                            clicked => {
                                root.request-provider-edit(provider.id);
                            }
                        }

                        Button {
                            accessible-label: "Delete provider " + provider.name;
                            text: "Delete";
                            clicked => {
                                root.request-provider-delete(provider.id);
                            }
                        }
                    }
                    if root.width >= Dimensions.narrow-layout-breakpoint: HorizontalLayout {
                        spacing: 8px;
                        Button {
                            accessible-label: "Verify provider " + provider.name;
                            text: provider.verifying ? "Verifying…" : "Verify";
                            enabled: !provider.verifying;
                            clicked => {
                                root.verify-saved-provider(provider.id);
                            }
                        }

                        Button {
                            accessible-label: "Edit provider " + provider.name;
                            text: "Edit";
                            clicked => {
                                root.request-provider-edit(provider.id);
                            }
                        }

                        Button {
                            accessible-label: "Delete provider " + provider.name;
                            text: "Delete";
                            clicked => {
                                root.request-provider-delete(provider.id);
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
