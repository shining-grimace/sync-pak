import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";

export component SuccessLabel inherits Text {
    min-width: 0px;
    max-height: self.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    color: Colors.success;
    font-size: Dimensions.text-size-description;
    wrap: word-wrap;
    horizontal-alignment: start;
}
