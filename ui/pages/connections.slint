import {
    Button,
    HorizontalBox,
    ListView,
    ScrollView,
    VerticalBox,
} from "std-widgets.slint";
import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { ConnectionRow } from "../models.slint";
import { CenteredPageColumn } from "../components/page-layouts.slint";

export component ConnectionsPage inherits ScrollView {
    in property <[ConnectionRow]> connections;
    in property <int> connections-total;
    in property <int> providers-total;
    in-out property <int> connection-filter;
    in property <bool> connections-load-failed;
    callback show-connections();
    callback show-add-provider();
    callback show-add-connection();
    callback set-connection-filter(int);
    callback request-run-connection(string);
    callback request-connection-edit(string);
    callback request-connection-delete(string);
    vertical-scrollbar-policy: always-on;
    CenteredPageColumn {
        width: parent.width - 12px;
        Text {
            text: "Connections";
            color: Colors.text-primary;
            font-size: 32px;
            font-weight: 800;
        }

        Text {
            text: "A connection links a local folder with a folder in one cloud bucket.";
            color: Colors.text-secondary;
            wrap: word-wrap;
        }

        if root.connections-load-failed: VerticalBox {
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                forward-focus: connections-retry;
                init => {
                    self.focus();
                }
            }

            accessible-role: region;
            accessible-label: "Connections unavailable";
            spacing: 8px;
            Text {
                text: "Connections unavailable";
                color: Colors.danger;
                font-size: 22px;
                font-weight: 700;
            }

            Text {
                text: "SyncPak could not load connections. Check configuration storage and try again.";
                color: Colors.danger;
                wrap: word-wrap;
            }

            connections-retry := Button {
                accessible-label: "Retry loading connections";
                text: "Retry";
                primary: true;
                clicked => {
                    root.show-connections();
                }
            }
        }
        if !root.connections-load-failed: VerticalBox {
            spacing: 12px;
            if root.providers-total == 0: VerticalBox {
                FocusScope {
                    width: 0px;
                    height: 0px;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                    forward-focus: connection-add-provider;
                    init => {
                        self.focus();
                    }
                }

                connection-add-provider := Button {
                    accessible-label: "Add a provider before creating a connection";
                    text: "Add provider";
                    height: Dimensions.control-height;
                    primary: true;
                    clicked => {
                        root.show-add-provider();
                    }
                }
            }
            if root.providers-total > 0: VerticalBox {
                FocusScope {
                    width: 0px;
                    height: 0px;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                    forward-focus: connection-new;
                    init => {
                        self.focus();
                    }
                }

                connection-new := Button {
                    accessible-label: "Create a new connection";
                    text: "New connection";
                    height: Dimensions.control-height;
                    primary: true;
                    clicked => {
                        root.show-add-connection();
                    }
                }
            }
            VerticalBox {
                accessible-role: region;
                accessible-label: "Filter connections by mode";
                spacing: 6px;
                Text {
                    text: "Filter by mode";
                    color: Colors.text-secondary;
                    font-weight: 700;
                }

                HorizontalBox {
                    spacing: 6px;
                    Button {
                        accessible-label: root.connection-filter == 0 ? "All connections, selected" : "Show all connections";
                        text: "All";
                        primary: root.connection-filter == 0;
                        clicked => {
                            root.set-connection-filter(0);
                        }
                    }

                    Button {
                        accessible-label: root.connection-filter == 1 ? "Add-only connections, selected" : "Show add-only connections";
                        text: "Add-only";
                        primary: root.connection-filter == 1;
                        clicked => {
                            root.set-connection-filter(1);
                        }
                    }
                }

                HorizontalBox {
                    spacing: 6px;
                    Button {
                        accessible-label: root.connection-filter == 2 ? "Mirror connections, selected" : "Show mirror connections";
                        text: "Mirror";
                        primary: root.connection-filter == 2;
                        clicked => {
                            root.set-connection-filter(2);
                        }
                    }

                    Button {
                        accessible-label: root.connection-filter == 3 ? "Archive connections, selected" : "Show archive connections";
                        text: "Archive";
                        primary: root.connection-filter == 3;
                        clicked => {
                            root.set-connection-filter(3);
                        }
                    }
                }
            }

            if root.connections-total > 0: Text {
                text: root.connections.length == root.connections-total ? "Showing all " + root.connections-total + (root.connections-total == 1 ? " connection." : " connections.") : "Showing " + root.connections.length + " of " + root.connections-total + " connections.";
                color: Colors.text-secondary;
                wrap: word-wrap;
            }
            if root.connections.length == 0: VerticalBox {
                spacing: 8px;
                Text {
                    text: root.connections-total == 0 ? "No connections yet" : "No matching connections";
                    font-size: 22px;
                    font-weight: 700;
                }

                if root.connections-total == 0 && root.providers-total == 0: Text {
                    text: "Add a cloud provider, then create a connection to choose what to copy.";
                    wrap: word-wrap;
                }
                if root.connections-total == 0 && root.providers-total > 0: Text {
                    text: "Create a connection to link a local folder with cloud storage.";
                    wrap: word-wrap;
                }
                if root.connections-total > 0: Text {
                    text: "Choose another filter or create a new connection.";
                    wrap: word-wrap;
                }
                if root.connections-total > 0 && root.connection-filter != 0: Button {
                    accessible-label: "Remove the connection filter and show all connections";
                    text: "Show all connections";
                    primary: true;
                    clicked => {
                        root.set-connection-filter(0);
                    }
                }
            }
            if root.connections.length > 0: ListView {
                height: 280px;
                vertical-scrollbar-policy: always-on;
                for connection in root.connections: Rectangle {
                    accessible-role: list-item;
                    accessible-label: connection.name + ". " + connection.detail + ". On this device: " + connection.local-path + ". In " + connection.provider-name + ": " + connection.remote-location;
                    background: Colors.surface;
                    border-color: Colors.border;
                    border-width: 1px;
                    border-radius: 8px;
                    min-height: root.width < Dimensions.narrow-layout-breakpoint ? 250px : 98px;
                    VerticalBox {
                        padding: 10px;
                        spacing: 8px;
                        VerticalBox {
                            spacing: 3px;
                            Text {
                                text: connection.name;
                                font-weight: 700;
                                wrap: word-wrap;
                            }

                            Text {
                                text: connection.detail;
                                color: Colors.text-secondary;
                            }

                            if root.width < Dimensions.medium-layout-breakpoint: VerticalBox {
                                spacing: 6px;
                                VerticalBox {
                                    spacing: 2px;
                                    Text {
                                        text: "On this device";
                                        color: Colors.text-secondary;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: connection.local-path;
                                        color: Colors.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                Text {
                                    accessible-label: connection.mode == 2 ? "Archive destination" : "Connected folders";
                                    text: connection.mode == 2 ? "↓ Archive destination" : "↕ Connected folders";
                                    color: Colors.border;
                                    font-weight: 700;
                                }

                                VerticalBox {
                                    spacing: 2px;
                                    Text {
                                        text: "In " + connection.provider-name;
                                        color: Colors.text-secondary;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: connection.remote-location;
                                        color: Colors.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            if root.width >= Dimensions.medium-layout-breakpoint: HorizontalBox {
                                spacing: 8px;
                                VerticalBox {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "On this device";
                                        color: Colors.text-secondary;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: connection.local-path;
                                        color: Colors.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }

                                Text {
                                    accessible-label: connection.mode == 2 ? "Archive destination" : "Connected folders";
                                    text: connection.mode == 2 ? "▣" : "⇄";
                                    color: Colors.border;
                                    font-size: 22px;
                                    vertical-alignment: center;
                                }

                                VerticalBox {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: "In " + connection.provider-name;
                                        color: Colors.text-secondary;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                    }

                                    Text {
                                        text: connection.remote-location;
                                        color: Colors.text-secondary;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                            if connection.mode == 2: Text {
                                text: "Keeps the last " + connection.archive-retention + " archives";
                                color: Colors.text-secondary;
                            }
                        }

                        if root.width < Dimensions.narrow-layout-breakpoint: VerticalBox {
                            spacing: 8px;
                            Button {
                                accessible-label: "Run connection " + connection.name;
                                text: "Run";
                                primary: true;
                                clicked => {
                                    root.request-run-connection(connection.id);
                                }
                            }

                            Button {
                                accessible-label: "Edit connection " + connection.name;
                                text: "Edit";
                                clicked => {
                                    root.request-connection-edit(connection.id);
                                }
                            }

                            Button {
                                accessible-label: "Delete connection " + connection.name;
                                text: "Delete";
                                clicked => {
                                    root.request-connection-delete(connection.id);
                                }
                            }
                        }
                        if root.width >= Dimensions.narrow-layout-breakpoint: HorizontalBox {
                            spacing: 8px;
                            Button {
                                accessible-label: "Run connection " + connection.name;
                                text: "Run";
                                primary: true;
                                clicked => {
                                    root.request-run-connection(connection.id);
                                }
                            }

                            Button {
                                accessible-label: "Edit connection " + connection.name;
                                text: "Edit";
                                clicked => {
                                    root.request-connection-edit(connection.id);
                                }
                            }

                            Button {
                                accessible-label: "Delete connection " + connection.name;
                                text: "Delete";
                                clicked => {
                                    root.request-connection-delete(connection.id);
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
