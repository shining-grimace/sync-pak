import { Palette } from "std-widgets.slint";
import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { InputPositionRefresh } from "../input-position-refresh.slint";

export component LineEdit inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> font-family: "";
    in property <bool> font-italic: false;
    in property <length> font-size: 0px;
    in property <int> font-weight: 400;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    in property <InputType> input-type: InputType.text;
    in property <string> placeholder-text: "";
    in property <bool> read-only: false;
    in-out property <string> text: "";
    out property <bool> has-focus: editor.has-focus;
    private property <int> input-position-refresh-generation: InputPositionRefresh.generation;

    callback accepted(string);
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;
    callback key-released(KeyEvent) -> EventResult;

    public function set-selection-offsets(start: int, end: int) {
        editor.set-selection-offsets(start, end);
    }

    public function select-all() {
        editor.select-all();
    }

    public function clear-selection() {
        editor.clear-selection();
    }

    public function cut() {
        editor.cut();
    }

    public function copy() {
        editor.copy();
    }

    public function paste() {
        editor.paste();
    }

    height: Dimensions.control-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    min-width: 1px;
    border-radius: Dimensions.input-border-radius;
    border-width: 1px;
    border-color: root.has-focus ? Colors.secondary : Colors.primary;
    background: Palette.control-background;
    opacity: root.enabled ? 1 : 0.55;
    clip: true;
    forward-focus: editor;
    accessible-role: text-input;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: root.read-only;
    accessible-action-set-value(value) => {
        root.text = value;
        root.edited(value);
    }

    changed input-position-refresh-generation => {
        if editor.has-focus {
            // Slint 1.17.1 does not refresh Android's native selection handle when only an
            // ancestor viewport moves. Re-applying the unchanged selection refreshes its
            // IME geometry without disturbing focus, composition, or the keyboard.
            editor.set-selection-offsets(
                editor.anchor-position-byte-offset,
                editor.cursor-position_byte-offset,
            );
        }
    }

    text-clip := Rectangle {
        x: 12px;
        width: max(0px, parent.width - 24px);
        height: parent.height;
        clip: true;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.text == "" && editor.preedit-text == "" ? root.placeholder-text : "";
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-italic: root.font-italic;
            color: Palette.alternate-foreground;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: center;
            accessible-role: none;
        }

        editor := TextInput {
            private property <length> computed-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            input-type: root.input-type;
            single-line: true;
            font-family: root.font-family;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-italic: root.font-italic;
            color: Palette.foreground;
            horizontal-alignment: root.horizontal-alignment;
            vertical-alignment: center;
            accessible-role: none;

            cursor-position-changed(position) => {
                if position.x + self.computed-x < 0px {
                    self.computed-x = -position.x;
                } else if position.x + self.computed-x > parent.width - self.text-cursor-width {
                    self.computed-x = parent.width - position.x - self.text-cursor-width;
                }
            }

            accepted => {
                root.accepted(self.text);
            }

            edited => {
                root.edited(self.text);
            }

            key-pressed(event) => {
                root.key-pressed(event)
            }

            key-released(event) => {
                root.key-released(event)
            }
        }
    }
}
