import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { PrimaryActionButton, SecondaryActionButton } from "../components/action-buttons.slint";

export component ConnectionDiscardConfirmationPage inherits CenteredPageRoot {
    in property <string> connection-name;
    callback cancel();
    callback confirm();

    HeadingLabel {
        text: "Discard unsaved changes?";
    }

    DescriptionLabel {
        text: "Your changes to this connection have not been saved.";
    }

    VerticalLayout {
        SecondaryActionButton {
            accessible-label: "Continue editing connection " + root.connection-name;
            text: "Continue Editing";
            clicked => {
                root.cancel();
            }
        }

        PrimaryActionButton {
            accessible-label: "Discard changes to connection " + root.connection-name;
            text: "Discard " + root.connection-name + " Changes";
            clicked => {
                root.confirm();
            }
        }
    }
}
