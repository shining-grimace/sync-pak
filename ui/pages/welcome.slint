import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";

export component WelcomePage inherits CenteredPageRoot {
    in property <bool> configuration-unavailable;
    callback retry-configuration();
    callback show-add-provider();
    callback show-privacy();

    VerticalBox {
        spacing: 14px;
        alignment: center;
            Text { text: "Your files, your cloud."; color: Colors.text-primary; font-size: 36px; font-weight: 800; horizontal-alignment: center; wrap: word-wrap; }
            Text { text: "SyncPak copies folders directly between this device and cloud providers you choose. SyncPak does not operate an intermediary file service."; color: Colors.text-secondary; font-size: 18px; horizontal-alignment: center; wrap: word-wrap; max-width: Dimensions.welcome-content-max-width; }
            Rectangle { height: 16px; background: transparent; }
            Rectangle { accessible-role: region; accessible-label: "Protected credentials"; background: Colors.surface; border-color: Colors.border; border-width: 2px; border-radius: 12px; max-width: Dimensions.welcome-content-max-width; min-height: 92px;
                Text { text: "Your provider credentials are protected using this device's secure storage and are sent only to that provider."; color: Colors.border; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; x: 24px; width: parent.width - 48px; height: parent.height; }
            }
            Rectangle { accessible-role: region; accessible-label: "Choose how each connection behaves"; background: Colors.surface; border-color: Colors.border; border-width: 1px; border-radius: 12px; max-width: Dimensions.welcome-content-max-width; min-height: 106px;
                VerticalBox { padding: 14px; spacing: 5px;
                    Text { text: "Choose how each connection behaves"; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Add-only — Copy new files without overwriting or deleting anything."; color: Colors.text-secondary; wrap: word-wrap; }
                    Text { text: "Mirror — Attempt to make a destination match its source after previewing destructive changes. Any issues are listed when the operation finishes."; color: Colors.text-secondary; wrap: word-wrap; }
                    Text { text: "Archive — Create timestamped ZIP archives and keep the number you choose."; color: Colors.text-secondary; wrap: word-wrap; }
                }
            }
            Rectangle { height: 16px; background: transparent; }
            if root.configuration-unavailable : Rectangle { accessible-role: region; accessible-label: "Configuration storage unavailable"; background: Colors.danger-surface; border-color: Colors.danger; border-width: 1px; border-radius: 12px; max-width: Dimensions.welcome-content-max-width; min-height: 122px;
                VerticalBox { padding: 14px; spacing: 6px;
                    Text { text: "Configuration storage is unavailable"; color: Colors.danger; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                    Text { text: "SyncPak cannot save providers or connections until its configuration storage is available."; color: Colors.danger; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalBox { alignment: center; FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: retry-configuration; init => { self.focus(); } } retry-configuration := Button { accessible-label: "Retry opening configuration storage"; text: "Retry"; primary: true; clicked => { root.retry-configuration(); } } }
                }
            }
            if !root.configuration-unavailable : HorizontalBox { alignment: center; FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: welcome-add-provider; init => { self.focus(); } } welcome-add-provider := Button { accessible-label: "Add your first provider"; text: "Add your first provider"; primary: true; preferred-width: Dimensions.welcome-action-max-width; max-width: Dimensions.welcome-action-max-width; clicked => { root.show-add-provider(); } }
            }
            HorizontalBox { alignment: center; Button { accessible-label: "Read how SyncPak protects your privacy"; text: "Read how SyncPak protects your privacy"; preferred-width: Dimensions.welcome-action-max-width; max-width: Dimensions.welcome-action-max-width; clicked => { root.show-privacy(); } } }
    }
}
