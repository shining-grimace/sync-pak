import { CenteredPageRoot } from "../components/page-layouts.slint";
import { Dimensions } from "../dimensions.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { InfoCard } from "../components/cards.slint";
import { PrimaryActionButton, SecondaryActionButton, ToggleButton } from "../components/action-buttons.slint";
import { ActionGroup } from "../components/list-and-action-layouts.slint";

export component RunDirectionPage inherits CenteredPageRoot {
    in property <string> connection-name;
    in property <string> connection-mode;
    in property <string> local-endpoint;
    in property <string> remote-endpoint;
    in property <string> archive-upload-details;
    in property <string> archive-download-details;
    in property <bool> allows-both-ways;
    in property <bool> allows-upload;
    in property <bool> allows-download;
    in property <bool> upload-selected;
    in property <bool> download-selected;
    callback set-upload-selected(bool);
    callback set-download-selected(bool);
    callback cancel();
    callback begin-preflight();

    HeadingLabel {
        text: "Run " + root.connection-name;
        wrap: word-wrap;
    }

    DescriptionLabel {
        text: root.connection-mode + " connection";
    }

    if root.upload-selected && !root.download-selected && root.archive-upload-details != "": InfoCard {
        baseline-height: 66px;
        vertical-stretch: 0;
        DescriptionLabel {
            text: root.archive-upload-details;
        }
    }
    if !root.upload-selected && root.download-selected && root.archive-download-details != "": InfoCard {
        baseline-height: 66px;
        vertical-stretch: 0;
        DescriptionLabel {
            text: root.archive-download-details;
        }
    }
    HorizontalLayout {
        spacing: Dimensions.element-gap;
        vertical-stretch: 0;
        ToggleButton {
            accessible-label: root.upload-selected ? "Upload direction, selected" : "Select upload direction";
            text: "Upload";
            selected: root.upload-selected;
            enabled: root.allows-upload;
            clicked => {
                root.set-upload-selected(!root.upload-selected);
            }
        }
        ToggleButton {
            accessible-label: root.download-selected ? "Download direction, selected" : "Select download direction";
            text: "Download";
            selected: root.download-selected;
            enabled: root.allows-download && (root.allows-both-ways || !root.upload-selected);
            clicked => {
                root.set-download-selected(!root.download-selected);
            }
        }
    }

    if root.upload-selected && !root.download-selected: InfoCard {
        accessible-role: region;
        accessible-label: "Upload direction. Source: " + root.local-endpoint + ". Destination: " + root.remote-endpoint;
        baseline-height: 132px;
        vertical-stretch: 0;
        SectionHeadingLabel {
            text: "Upload";
        }

        DescriptionLabel {
            text: "Use the local folder as the source and cloud storage as the destination.";
        }

    }

    if !root.upload-selected && root.download-selected: InfoCard {
        accessible-role: region;
        accessible-label: "Download direction. Source: " + root.remote-endpoint + ". Destination: " + root.local-endpoint;
        baseline-height: 132px;
        vertical-stretch: 0;
        SectionHeadingLabel {
            text: "Download";
        }

        DescriptionLabel {
            text: "Use cloud storage as the source and the local folder as the destination.";
        }

    }

    if root.upload-selected && root.download-selected: InfoCard {
        accessible-role: region;
        accessible-label: "Both ways direction between " + root.local-endpoint + " and " + root.remote-endpoint;
        baseline-height: 132px;
        vertical-stretch: 0;
        SectionHeadingLabel {
            text: "Both ways";
        }

        DescriptionLabel {
            text: "Copy files found on only one side to the other. Changed files are skipped.";
        }

    }

    if !root.upload-selected && !root.download-selected: DescriptionLabel {
        accessible-live-region: polite;
        text: "Please select at least one transfer direction";
    }
    DescriptionLabel {
        text: "Continue performs a read-only inventory and shows the complete plan before any files can change.";
    }

    DescriptionLabel {
        text: "This device: " + root.local-endpoint;
    }

    DescriptionLabel {
        text: "Cloud storage: " + root.remote-endpoint;
    }

    ActionGroup {
        SecondaryActionButton {
            accessible-label: "Cancel run for " + root.connection-name;
            text: "Cancel";
            clicked => {
                root.cancel();
            }
        }

        PrimaryActionButton {
            accessible-label: root.upload-selected || root.download-selected ? "Continue to preflight for " + root.connection-name : "Select at least one transfer direction before reviewing the plan";
            text: "Review Plan";
            enabled: root.upload-selected || root.download-selected;
            clicked => {
                root.begin-preflight();
            }
        }
    }

    Rectangle {
        vertical-stretch: 1;
    }
}
