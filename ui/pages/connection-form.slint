import { DangerCard } from "../components/cards.slint";
import { TransportFields } from "../components/transport-fields.slint";
import { Dimensions } from "../dimensions.slint";
import { PageRoot, CenteredPageColumn } from "../components/page-layouts.slint";
import { PageHeader } from "../components/page-header.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import {
    PrimaryActionButton,
    ExpandedPrimaryActionButton,
    ExpandedSecondaryActionButton,
    ToggleButton,
} from "../components/action-buttons.slint";
import { ComboBox, LineEdit } from "../components/form-controls.slint";

export component ConnectionFormPage inherits Rectangle {
    in-out property <string> connection-form-id;
    in-out property <string> connection-form-name;
    in-out property <int> connection-form-provider;
    in-out property <string> connection-form-bucket;
    in-out property <string> connection-form-remote;
    in-out property <string> connection-form-local;
    in-out property <int> connection-form-mode;
    in-out property <bool> connection-form-allow-upload;
    in-out property <bool> connection-form-allow-download;
    in-out property <bool> connection-form-show-preview: true;
    in-out property <string> connection-form-retention;
    in property <[string]> provider-names;
    in property <[string]> provider-buckets;
    in property <[string]> connection-verified-buckets;
    in property <bool> connection-bucket-list-checked;
    in property <bool> connection-providers-loading;
    in property <bool> connection-providers-load-failed;
    in property <bool> folder-picker-open;
    in property <bool> connection-verifying;
    in property <int> validation-focus;
    in-out property <bool> connection-form-use-provider-settings;
    in-out property <string> connection-form-endpoint;
    in-out property <string> connection-form-region;
    in property <int> transport-kind;
    in property <string> transport-summary;
    pure callback infer-b2-region(string) -> string;
    callback select-local-folder();
    callback select-connection-provider(int);
    callback retry-connection-providers();
    callback save-connection(string, int, string, string, string, int, string, bool, bool);
    callback verify-connection();
    callback save-and-verify-connection();
    callback request-discard-connection();

    changed validation-focus => {
        if root.validation-focus == 1 { connection-name.focus(); }
        if root.validation-focus == 2 { connection-provider.focus(); }
        if root.validation-focus == 3 { connection-bucket.focus(); }
        if root.validation-focus == 4 { connection-local.focus(); }
    }

    VerticalLayout {
        spacing: 0px;
        CenteredPageColumn {
            vertical-stretch: 0;
            padding-bottom: Dimensions.section-gap;
            PageHeader {
                title: root.connection-form-id == "" ? "New Connection" : "Edit " + root.connection-form-name;
                back-label: "Back to connections";
                back => {
                    root.request-discard-connection();
                }
            }
        }

        PageRoot {
            vertical-stretch: 1;
            CenteredPageColumn {
                width: parent.visible-width;
                DescriptionLabel {
                    text: "Save only stores this connection. It does not transfer files.";
                }

                VerticalLayout {
                    accessible-role: region;
                    accessible-label: "Connection identity and cloud destination";
                    spacing: Dimensions.element-gap;
                    FocusScope {
                        width: 0px;
                        height: 0px;
                        focus-on-click: false;
                        focus-on-tab-navigation: false;
                        forward-focus: connection-name;
                        init => {
                            self.focus();
                        }
                    }

                    SectionHeadingLabel {
                        text: "Connection name";
                    }

                    connection-name := LineEdit {
                        accessible-label: "Connection name";
                        placeholder-text: "For example, Photos backup";
                        text <=> root.connection-form-name;
                        enabled: !root.connection-verifying;
                    }

                    DescriptionLabel {
                        text: "Used in the connection list and archive filenames.";
                    }

                    SectionHeadingLabel {
                        text: "Provider";
                    }

                    connection-provider := ComboBox {
                        accessible-label: root.connection-providers-loading ? "Loading providers" : (root.connection-providers-load-failed ? "Providers unavailable" : (root.provider-names.length == 0 ? "Provider; add a provider first" : "Provider"));
                        model: root.provider-names;
                        enabled: !root.connection-verifying && !root.folder-picker-open && !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length > 0;
                        current-index <=> root.connection-form-provider;
                        selected => {
                            root.select-connection-provider(self.current-index);
                        }
                    }

                    if root.connection-providers-loading: DescriptionLabel {
                        accessible-live-region: polite;
                        text: "Loading providers…";
                    }
                    if root.connection-providers-load-failed: VerticalLayout {
                        spacing: Dimensions.element-gap;
                        ErrorLabel {
                            accessible-live-region: assertive;
                            text: "SyncPak could not load providers. Check configuration storage and try again.";
                        }

                        PrimaryActionButton {
                            accessible-label: "Retry loading providers for this connection";
                            text: root.connection-providers-loading ? "Retrying…" : "Retry Providers";
                            enabled: !root.connection-providers-loading;
                            clicked => {
                                root.retry-connection-providers();
                            }
                        }
                    }
                    if !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length == 0: ErrorLabel {
                        text: "Add a provider before creating a connection.";
                    }
                    SectionHeadingLabel {
                        text: "Bucket";
                    }

                    connection-bucket := LineEdit {
                        accessible-label: connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] != "" ? "Bucket locked to the provider’s fixed bucket" : "Bucket";
                        placeholder-text: "Bucket name";
                        text <=> root.connection-form-bucket;
                        enabled: !root.connection-verifying && !root.folder-picker-open && connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "";
                    }

                    if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] != "" && root.connection-form-bucket == root.provider-buckets[connection-provider.current-index]: DescriptionLabel {
                        text: "This provider uses a fixed bucket: " + root.provider-buckets[connection-provider.current-index] + ".";
                    }
                    if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] != "" && root.connection-form-bucket != root.provider-buckets[connection-provider.current-index]: DescriptionLabel {
                        text: "This existing connection keeps its saved bucket. Saving this form will not automatically adopt the provider’s current fixed bucket.";
                    }
                    if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "" && root.connection-bucket-list-checked && root.connection-verified-buckets.length > 0: VerticalLayout {
                        spacing: Dimensions.element-gap;
                        DescriptionLabel {
                            text: "Discovered buckets";
                        }

                        ComboBox {
                            accessible-label: "Discovered buckets";
                            model: root.connection-verified-buckets;
                            enabled: !root.connection-verifying && !root.folder-picker-open;
                            selected => {
                                root.connection-form-bucket = root.connection-verified-buckets[self.current-index];
                            }
                        }
                    }
                    if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "" && root.connection-bucket-list-checked && root.connection-verified-buckets.length == 0: DescriptionLabel {
                        text: "No bucket names were discovered. Enter the bucket name manually and verify this connection to check its access.";
                    }
                    if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "" && !root.connection-bucket-list-checked: DescriptionLabel {
                        text: "Enter the bucket name manually, or verify this provider to select buckets visible to its current credentials.";
                    }
                    if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "": DescriptionLabel {
                        text: "You can also enter a bucket manually. Listed buckets may have different access permissions.";
                    }
                    SectionHeadingLabel {
                        text: "Connection settings";
                    }
                    ComboBox {
                        accessible-label: "Connection settings source";
                        model: ["Use provider settings", "Configure for this connection"];
                        current-index: root.connection-form-use-provider-settings ? 0 : 1;
                        enabled: !root.connection-verifying && !root.folder-picker-open && !root.connection-providers-loading && root.transport-kind >= 0;
                        selected => {
                            root.connection-form-use-provider-settings = self.current-index == 0;
                        }
                    }
                    if !root.connection-form-use-provider-settings && root.transport-kind >= 0: TransportFields {
                        kind: root.transport-kind;
                        endpoint <=> root.connection-form-endpoint;
                        region <=> root.connection-form-region;
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                        infer-b2-region(value) => {
                            return root.infer-b2-region(value);
                        }
                    }
                    DescriptionLabel {
                        accessible-live-region: polite;
                        text: root.transport-summary;
                    }
                    SectionHeadingLabel {
                        text: "Remote folder";
                    }

                    connection-remote := LineEdit {
                        accessible-label: "Remote folder";
                        placeholder-text: "Leave empty for the bucket root";
                        text <=> root.connection-form-remote;
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                    }

                    DescriptionLabel {
                        text: "Leave empty to use the root of the bucket.";
                    }
                }

                SectionHeadingLabel {
                    text: "Local folder";
                }

                VerticalLayout {
                    spacing: Dimensions.element-gap;
                    connection-local := LineEdit {
                        accessible-label: "Local folder";
                        placeholder-text: "Full local folder path";
                        text <=> root.connection-form-local;
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                    }

                    DescriptionLabel {
                        text: "Selecting a folder lets SyncPak inventory and transfer files only for this connection. Your system may ask you to allow access to the folder you choose.";
                    }

                    PrimaryActionButton {
                        accessible-label: root.folder-picker-open ? "Folder selection in progress" : "Select local folder";
                        text: root.folder-picker-open ? "Selecting Folder…" : "Select Folder";
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                        clicked => {
                            root.select-local-folder();
                        }
                    }

                    if root.folder-picker-open: DescriptionLabel {
                        accessible-live-region: polite;
                        text: "Waiting for folder selection…";
                    }
                }

                SectionHeadingLabel {
                    text: "Mode";
                }

                connection-mode := ComboBox {
                    accessible-label: "Mode";
                    model: ["Add-only", "Mirror", "Archive"];
                    current-index <=> root.connection-form-mode;
                    enabled: !root.connection-verifying && !root.folder-picker-open;
                }

                if connection-mode.current-index == 0: DescriptionLabel {
                    text: "Copies files that exist only at the source. Existing changed files are skipped, and nothing is overwritten or deleted.";
                }
                if connection-mode.current-index == 1: DescriptionLabel {
                    text: "Attempts to make the destination match the source. Any files or metadata that cannot be matched are listed when the operation finishes.";
                }
                if connection-mode.current-index == 2: VerticalLayout {
                    spacing: Dimensions.element-gap;
                    DescriptionLabel {
                        text: "Creates a timestamped ZIP from the source and stores it at the destination. Older archives are removed according to this connection's retention setting.";
                    }

                    SectionHeadingLabel {
                        text: "Keep last N archives";
                    }

                    connection-retention := LineEdit {
                        accessible-label: "Keep last N archives";
                        text <=> root.connection-form-retention;
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                    }

                    DescriptionLabel {
                        text: "After a new archive is saved successfully, older archives made by this connection are deleted until this many remain.";
                    }
                }
                SectionHeadingLabel {
                    text: "Allowed directions";
                }
                DescriptionLabel {
                    text: root.connection-form-show-preview ? (root.connection-form-mode == 0 ? "Choose which directions can be selected when this connection runs." : "Allow upload, download, or both. Choose one allowed direction for each run.") : (root.connection-form-mode == 0 ? "Sync runs automatically in the allowed directions." : "Choose one direction for automatic sync.");
                }
                HorizontalLayout {
                    spacing: Dimensions.element-gap;
                    ToggleButton {
                        text: "Upload";
                        selected: root.connection-form-allow-upload;
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                        clicked => {
                            root.connection-form-allow-upload = !root.connection-form-allow-upload;
                        }
                    }
                    ToggleButton {
                        text: "Download";
                        selected: root.connection-form-allow-download;
                        enabled: !root.connection-verifying && !root.folder-picker-open;
                        clicked => {
                            root.connection-form-allow-download = !root.connection-form-allow-download;
                        }
                    }
                }
                SectionHeadingLabel {
                    text: "Show Preview";
                }
                DescriptionLabel {
                    text: "Show the preflight screen before running a sync to preview the file transfers that will occur";
                }
                ComboBox {
                    accessible-label: "Show Preview";
                    model: ["Show preview before sync", "Don't show preview"];
                    current-index: root.connection-form-show-preview ? 0 : 1;
                    enabled: !root.connection-verifying && !root.folder-picker-open;
                    selected => {
                        root.connection-form-show-preview = self.current-index == 0;
                    }
                }
                if !root.connection-form-show-preview && root.connection-form-mode != 0 && root.connection-form-allow-upload && root.connection-form-allow-download: ErrorLabel {
                    text: "Choose one allowed direction for Mirror or Archive when preview is disabled.";
                }
                if root.connection-form-mode == 1 && !root.connection-form-show-preview: DangerCard {
                    accessible-role: region;
                    accessible-label: "Mirror mode without preview";
                    ErrorLabel {
                        text: "Mirror mode can perform destructive changes, like deleting an entire directory if it does not exist on the mirrored source. Previewing changes before running sync is recommended for important files.";
                    }
                }

                if root.connection-verifying: DescriptionLabel {
                    accessible-live-region: polite;
                    text: "Checking the local folder and cloud path without changing files…";
                }
            }
        }

        CenteredPageColumn {
            vertical-stretch: 0;
            padding-top: Dimensions.section-gap;
            HorizontalLayout {
                spacing: Dimensions.element-gap;
                ExpandedSecondaryActionButton {
                    accessible-label: "Save connection " + root.connection-form-name + " without verifying";
                    text: "Save Unverified";
                    enabled: !root.connection-verifying && !root.folder-picker-open && !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length > 0;
                    clicked => {
                        root.save-connection(connection-name.text, connection-provider.current-index, connection-bucket.text, connection-remote.text, connection-local.text, connection-mode.current-index, root.connection-form-retention, root.connection-form-allow-upload, root.connection-form-allow-download);
                    }
                }

                ExpandedSecondaryActionButton {
                    accessible-label: "Verify connection settings for " + root.connection-form-name;
                    text: "Verify";
                    enabled: !root.connection-verifying && !root.folder-picker-open && !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length > 0;
                    clicked => {
                        root.verify-connection();
                    }
                }

                ExpandedPrimaryActionButton {
                    accessible-label: "Save and verify connection " + root.connection-form-name;
                    text: root.connection-verifying ? "Verifying…" : "Save & Verify";
                    enabled: !root.connection-verifying && !root.folder-picker-open && !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length > 0;
                    clicked => {
                        root.save-and-verify-connection();
                    }
                }
            }
        }
    }
}
