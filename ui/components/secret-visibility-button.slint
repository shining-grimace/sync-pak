import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { CardSecondaryActionButton } from "action-buttons.slint";

export component SecretVisibilityButton inherits CardSecondaryActionButton {
    in property <bool> revealed;
    in property <string> secret-name: "secret access key";

    button-width: Dimensions.control-height;
    button-height: Dimensions.control-height;
    accessible-label: (root.revealed ? "Hide " : "Reveal ") + root.secret-name;
    text: "";

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M2 12 C4.5 7 8 5 12 5 C16 5 19.5 7 22 12 C19.5 17 16 19 12 19 C8 19 4.5 17 2 12 Z M15 12 C15 13.66 13.66 15 12 15 C10.34 15 9 13.66 9 12 C9 10.34 10.34 9 12 9 C13.66 9 15 10.34 15 12 Z";
        fill: transparent;
        stroke: Colors.primary;
        stroke-width: 1.8px;
    }
    if root.revealed: Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M3 3 L21 21";
        stroke: Colors.primary;
        stroke-width: 2px;
    }
}
