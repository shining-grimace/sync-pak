import { Button, Palette } from "std-widgets.slint";
import { Dimensions } from "dimensions.slint";
import { Colors } from "colors.slint";
import { WelcomePage } from "pages/welcome.slint";
import { ProvidersPage } from "pages/providers.slint";
import { PrivacyPage } from "pages/privacy.slint";
import { DiagnosticsPage } from "pages/diagnostics.slint";
import {
    ProviderSaveConfirmationPage,
    ProviderDiscardConfirmationPage,
} from "pages/provider-confirmations.slint";
import {
    ConnectionDiscardConfirmationPage,
} from "pages/connection-confirmations.slint";
import {
    ProviderDeletePage,
    ConnectionDeletePage,
    ActivityCancelPage,
} from "pages/destructive-confirmations.slint";
import { ActivityProgressPage } from "pages/activity-progress.slint";
import { ActivityResultPage } from "pages/activity-result.slint";
import { ProviderFormPage } from "pages/provider-form.slint";
import { ConnectionsPage } from "pages/connections.slint";
import { ConnectionFormPage } from "pages/connection-form.slint";
import { ActivityPage } from "pages/activity.slint";
import { RunDirectionPage } from "pages/run-direction.slint";
import { PreflightPage } from "pages/preflight.slint";
import {
    ProviderRow,
    ConnectionRow,
    ActivityRow,
    PreflightRow,
} from "models.slint";

export global Page {
    out property <int> welcome: 0;
    out property <int> providers: 1;
    out property <int> provider-form: 2;
    out property <int> privacy: 3;
    out property <int> connections: 4;
    out property <int> connection-form: 5;
    out property <int> provider-delete: 6;
    out property <int> connection-delete: 7;
    out property <int> diagnostics: 8;
    out property <int> activity: 9;
    out property <int> run-direction: 10;
    out property <int> preflight: 11;
    out property <int> activity-cancel: 12;
    out property <int> provider-save-confirmation: 13;
    out property <int> connection-discard-confirmation: 14;
    out property <int> provider-discard-confirmation: 15;
    out property <int> activity-result: 16;
    out property <int> activity-progress: 17;
}

export component AppWindow inherits Window {
    in-out property <int> page: 0;
    in-out property <string> app-version;
    in-out property <int> appearance-preference: 0;
    in-out property <bool> resolved-dark-mode: false;
    in-out property <bool> configuration-unavailable: false;
    in-out property <[ProviderRow]> providers;
    in-out property <bool> providers-load-failed: false;
    in-out property <[ConnectionRow]> connections;
    in-out property <int> connections-total;
    in-out property <int> providers-total;
    in-out property <int> connection-filter: 0;
    in-out property <bool> connections-load-failed: false;
    in-out property <[ActivityRow]> activity-rows;
    in-out property <int> activity-clearable-count: 0;
    in-out property <string> activity-result-title;
    in-out property <string> activity-result-status;
    in-out property <string> activity-result-summary;
    in-out property <int> activity-result-completed-count: 0;
    in-out property <int> activity-result-incomplete-count: 0;
    in-out property <int> activity-result-not-started-count: 0;
    in-out property <[string]> activity-result-details;
    in-out property <string> activity-result-connection-id;
    in-out property <int> activity-result-retry-direction: 0;
    in-out property <bool> activity-result-can-retry: false;
    in-out property <string> activity-progress-id;
    in-out property <string> activity-progress-title;
    in-out property <string> activity-progress-phase;
    in-out property <string> activity-progress-summary;
    in-out property <string> activity-progress-items;
    in-out property <string> activity-progress-bytes;
    in-out property <string> activity-progress-path;
    in-out property <float> activity-progress-fraction: 0;
    in-out property <int> activity-progress-percent: 0;
    in-out property <string> active-activity-id;
    in-out property <string> active-activity-title;
    in-out property <string> active-activity-progress;
    in-out property <[string]> provider-names;
    in-out property <[string]> provider-buckets;
    in-out property <[string]> provider-verified-buckets;
    in-out property <bool> provider-bucket-list-empty: false;
    in-out property <string> status-message;
    in-out property <string> notice-message;
    in-out property <string> diagnostic-text;
    in-out property <bool> diagnostic-include-paths;
    in-out property <int> diagnostic-entry-count: 0;
    in-out property <string> diagnostic-copy-status;
    in-out property <int> diagnostic-return-page: 3;
    private property <bool> confirmation-open: page == Page.provider-delete || page == Page.connection-delete || page == Page.activity-cancel || page == Page.provider-save-confirmation || page == Page.connection-discard-confirmation || page == Page.provider-discard-confirmation;
    in-out property <string> pending-provider-id;
    in-out property <string> pending-provider-name;
    in-out property <int> pending-connection-count;
    in-out property <[string]> pending-provider-connections;
    in-out property <string> provider-form-id;
    in-out property <string> provider-form-name;
    in-out property <int> provider-form-kind;
    in-out property <string> provider-form-account-id;
    in-out property <string> provider-form-region;
    in-out property <string> provider-form-bucket;
    in-out property <string> provider-form-access-key;
    in-out property <string> provider-form-secret-key;
    in-out property <string> provider-form-endpoint;
    in-out property <string> provider-form-session-token;
    in-out property <string> provider-form-original;
    in-out property <bool> provider-secret-visible: false;
    in-out property <int> provider-secret-reveal-generation: 0;
    in-out property <bool> provider-advanced-expanded: false;
    in-out property <bool> provider-verifying: false;
    in-out property <int> provider-verification-generation: 0;
    in-out property <bool> provider-save-after-verification: false;
    in-out property <string> pending-connection-id;
    in-out property <string> pending-connection-name;
    in-out property <string> connection-form-id;
    in-out property <string> connection-form-name;
    in-out property <int> connection-form-provider;
    in-out property <bool> connection-providers-loading: false;
    in-out property <bool> connection-providers-load-failed: false;
    in-out property <string> connection-form-bucket;
    in-out property <[string]> connection-verified-buckets;
    in-out property <bool> connection-bucket-list-checked: false;
    in-out property <string> connection-form-remote;
    in-out property <string> connection-form-local;
    in-out property <int> connection-form-mode;
    in-out property <string> connection-form-retention: "1";
    in-out property <string> connection-form-original;
    in-out property <bool> folder-picker-open: false;
    in-out property <string> run-connection-id;
    in-out property <string> run-connection-name;
    in-out property <string> run-connection-mode;
    in-out property <string> run-local-endpoint;
    in-out property <string> run-remote-endpoint;
    in-out property <string> run-archive-upload-details;
    in-out property <string> run-archive-download-details;
    in-out property <bool> run-allows-both-ways;
    in-out property <int> run-direction: 0;
    in-out property <bool> preflight-loading: false;
    in-out property <bool> preflight-failed: false;
    in-out property <string> preflight-failure-message;
    in-out property <int> preflight-generation: 0;
    in-out property <string> preflight-additions;
    in-out property <string> preflight-overwrites;
    in-out property <string> preflight-deletions;
    in-out property <string> preflight-skipped;
    in-out property <string> preflight-start-action;
    in-out property <bool> preflight-requires-mirror-confirmation: false;
    in-out property <bool> preflight-mirror-confirmed: false;
    in-out property <int> preflight-item-filter: 0;
    in-out property <[PreflightRow]> preflight-items;
    in-out property <[PreflightRow]> preflight-visible-items;
    in-out property <string> pending-cancel-activity-id;
    in-out property <string> pending-cancel-activity-name;
    in-out property <int> pending-navigation-page: -1;
    callback show-providers();
    callback show-connections();
    callback show-add-provider();
    callback show-add-connection();
    callback show-welcome();
    callback retry-configuration();
    callback show-privacy();
    callback apply-appearance-preference();
    callback change-appearance-preference(int);
    callback show-activity();
    callback request-navigation(int);
    callback complete-pending-navigation();
    callback show-diagnostics();
    callback dismiss-diagnostics();
    callback set-diagnostic-include-paths(bool);
    callback request-provider-delete(string);
    callback request-provider-edit(string);
    callback verify-saved-provider(string);
    callback toggle-provider-secret-visibility();
    callback verify-provider();
    callback save-and-verify-provider();
    callback confirm-provider-delete();
    callback cancel-provider-delete();
    callback request-connection-delete(string);
    callback confirm-connection-delete();
    callback cancel-connection-delete();
    callback request-connection-edit(string);
    callback select-local-folder();
    callback select-connection-provider(int);
    callback retry-connection-providers();
    callback save-provider(string, int, string, string);
    callback request-save-provider();
    callback cancel-save-provider();
    callback request-discard-provider();
    callback confirm-discard-provider();
    callback cancel-discard-provider();
    callback save-connection(string, int, string, string, string, int, string);
    callback request-discard-connection();
    callback confirm-discard-connection();
    callback cancel-discard-connection();
    callback cancel-activity(string);
    callback request-cancel-activity(string, string);
    callback confirm-cancel-activity();
    callback dismiss-cancel-activity();
    callback remove-queued-activity(string);
    callback clear-completed-activity();
    callback show-activity-result(string);
    callback dismiss-activity-result();
    callback retry-activity-result();
    callback show-activity-progress(string);
    callback dismiss-activity-progress();
    callback request-run-connection(string);
    callback choose-run-direction(int);
    callback begin-preflight();
    callback start-preflight-operation();
    callback set-preflight-item-filter(int);
    callback cancel-run-direction();
    callback return-to-run-direction();
    callback set-connection-filter(int);

    init => {
        Palette.color-scheme = ColorScheme.unknown;
    }
    apply-appearance-preference => {
        Colors.dark-mode = root.resolved-dark-mode;
        Palette.color-scheme = root.appearance-preference == 1 ? ColorScheme.light : root.appearance-preference == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    title: "SyncPak";
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 360px;
    min-height: Dimensions.window-min-height;
    background: Colors.app-background;

    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;

        keyboard-shortcuts := FocusScope {
            width: 0px;
            height: 0px;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if event.text == Key.Escape {
                    if root.page == Page.provider-delete {
                        root.cancel-provider-delete();
                        return accept;
                    }
                    if root.page == Page.connection-delete {
                        root.cancel-connection-delete();
                        return accept;
                    }
                    if root.page == Page.diagnostics {
                        root.dismiss-diagnostics();
                        return accept;
                    }
                    if root.page == Page.run-direction {
                        root.cancel-run-direction();
                        return accept;
                    }
                    if root.page == Page.preflight {
                        root.return-to-run-direction();
                        return accept;
                    }
                    if root.page == Page.activity-cancel {
                        root.dismiss-cancel-activity();
                        return accept;
                    }
                    if root.page == Page.activity-result {
                        root.dismiss-activity-result();
                        return accept;
                    }
                    if root.page == Page.activity-progress {
                        root.dismiss-activity-progress();
                        return accept;
                    }
                    if root.page == Page.provider-save-confirmation {
                        root.cancel-save-provider();
                        return accept;
                    }
                    if root.page == Page.connection-discard-confirmation {
                        root.cancel-discard-connection();
                        return accept;
                    }
                    if root.page == Page.provider-discard-confirmation {
                        root.cancel-discard-provider();
                        return accept;
                    }
                    if root.page == Page.provider-form {
                        root.request-discard-provider();
                        return accept;
                    }
                    if root.page == Page.connection-form {
                        root.request-discard-connection();
                        return accept;
                    }
                }
                reject
            }
        }

        VerticalLayout {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            padding: 16px;
            padding-left: root.width >= Dimensions.desktop-layout-breakpoint ? 176px : 16px;
            spacing: 16px;

            if root.width >= Dimensions.medium-layout-breakpoint && root.width < Dimensions.desktop-layout-breakpoint: VerticalLayout {
                accessible-role: navigation;
                accessible-label: "Primary navigation";
                spacing: 6px;
                Text {
                    text: "SYNCPAK";
                    color: Colors.border;
                    font-size: 17px;
                    font-weight: 800;
                    letter-spacing: 2px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        accessible-label: (root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14) ? "Connections, selected" : "Connections";
                        text: "Connections";
                        primary: root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14;
                        enabled: !root.confirmation-open && !root.configuration-unavailable;
                        clicked => {
                            root.request-navigation(4);
                        }
                    }

                    Button {
                        accessible-label: (root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15) ? "Providers, selected" : "Providers";
                        text: "Providers";
                        primary: root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15;
                        enabled: !root.confirmation-open && !root.configuration-unavailable;
                        clicked => {
                            root.request-navigation(1);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        accessible-label: (root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17) ? "Activity, selected" : "Activity";
                        text: "Activity";
                        primary: root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17;
                        enabled: !root.confirmation-open && !root.configuration-unavailable;
                        clicked => {
                            root.request-navigation(9);
                        }
                    }

                    Button {
                        accessible-label: root.page == 3 ? "Privacy, selected" : "Privacy";
                        text: "Privacy";
                        primary: root.page == 3;
                        enabled: !root.confirmation-open;
                        clicked => {
                            root.request-navigation(3);
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }

            if root.status-message != "": Rectangle {
                accessible-role: region;
                accessible-label: "Action needed";
                background: Colors.danger-surface;
                border-color: Colors.danger;
                border-width: 1px;
                border-radius: 8px;
                min-height: 58px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Text {
                        text: "Action needed";
                        color: Colors.danger;
                        font-weight: 700;
                    }

                    Text {
                        accessible-live-region: assertive;
                        text: root.status-message;
                        color: Colors.danger;
                        wrap: word-wrap;
                    }

                    if root.diagnostic-entry-count > 0: Button {
                        accessible-label: "View redacted diagnostics for this error";
                        text: "View redacted diagnostics";
                        clicked => {
                            root.show-diagnostics();
                        }
                    }
                }
            }

            if root.notice-message != "": Rectangle {
                accessible-role: region;
                accessible-label: "Update";
                background: Colors.success-surface;
                border-color: Colors.success;
                border-width: 1px;
                border-radius: 8px;
                min-height: 48px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 4px;
                    Text {
                        text: "Update";
                        color: Colors.success;
                        font-weight: 700;
                    }

                    Text {
                        accessible-live-region: polite;
                        text: root.notice-message;
                        color: Colors.success;
                        wrap: word-wrap;
                    }
                }
            }

            if root.active-activity-id != "" && !root.confirmation-open: Rectangle {
                accessible-role: region;
                accessible-label: "Active operation " + root.active-activity-title;
                background: Colors.border;
                border-radius: 8px;
                min-height: 62px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: root.active-activity-title;
                            color: Colors.surface;
                            font-weight: 700;
                            wrap: word-wrap;
                        }

                        Text {
                            text: root.active-activity-progress;
                            color: Colors.surface;
                            wrap: word-wrap;
                        }
                    }

                    if root.width < Dimensions.narrow-layout-breakpoint: VerticalLayout {
                        spacing: 8px;
                        Button {
                            accessible-label: "View progress for " + root.active-activity-title;
                            text: "View progress";
                            clicked => {
                                root.show-activity-progress(root.active-activity-id);
                            }
                        }

                        Button {
                            accessible-label: "Cancel " + root.active-activity-title;
                            text: "Cancel";
                            clicked => {
                                root.request-cancel-activity(root.active-activity-id, root.active-activity-title);
                            }
                        }
                    }
                    if root.width >= Dimensions.narrow-layout-breakpoint: HorizontalLayout {
                        spacing: 8px;
                        Button {
                            accessible-label: "View progress for " + root.active-activity-title;
                            text: "View progress";
                            clicked => {
                                root.show-activity-progress(root.active-activity-id);
                            }
                        }

                        Button {
                            accessible-label: "Cancel " + root.active-activity-title;
                            text: "Cancel";
                            clicked => {
                                root.request-cancel-activity(root.active-activity-id, root.active-activity-title);
                            }
                        }
                    }
                }
            }

            if root.page == Page.welcome: WelcomePage {
                configuration-unavailable: root.configuration-unavailable;
                retry-configuration => {
                    root.retry-configuration();
                }
                show-add-provider => {
                    root.show-add-provider();
                }
                show-privacy => {
                    root.show-privacy();
                }
            }

            if root.page == Page.providers: ProvidersPage {
                providers: root.providers;
                load-failed: root.providers-load-failed;
                show-providers => {
                    root.show-providers();
                }
                show-add-provider => {
                    root.show-add-provider();
                }
                verify-saved-provider(id) => {
                    root.verify-saved-provider(id);
                }
                request-provider-edit(id) => {
                    root.request-provider-edit(id);
                }
                request-provider-delete(id) => {
                    root.request-provider-delete(id);
                }
            }

            if root.page == Page.provider-form: ProviderFormPage {
                provider-form-id <=> root.provider-form-id;
                provider-form-name <=> root.provider-form-name;
                provider-form-kind <=> root.provider-form-kind;
                provider-form-account-id <=> root.provider-form-account-id;
                provider-form-region <=> root.provider-form-region;
                provider-form-bucket <=> root.provider-form-bucket;
                provider-form-access-key <=> root.provider-form-access-key;
                provider-form-secret-key <=> root.provider-form-secret-key;
                provider-form-endpoint <=> root.provider-form-endpoint;
                provider-form-session-token <=> root.provider-form-session-token;
                provider-secret-visible <=> root.provider-secret-visible;
                provider-advanced-expanded <=> root.provider-advanced-expanded;
                provider-verifying: root.provider-verifying;
                provider-verified-buckets: root.provider-verified-buckets;
                provider-bucket-list-empty: root.provider-bucket-list-empty;
                toggle-provider-secret-visibility => {
                    root.toggle-provider-secret-visibility();
                }
                request-discard-provider => {
                    root.request-discard-provider();
                }
                request-save-provider => {
                    root.request-save-provider();
                }
                verify-provider => {
                    root.verify-provider();
                }
                save-and-verify-provider => {
                    root.save-and-verify-provider();
                }
            }

            if root.page == Page.provider-save-confirmation: ProviderSaveConfirmationPage {
                provider-name: root.provider-form-name;
                cancel => {
                    root.cancel-save-provider();
                }
                save => {
                    root.save-provider(root.provider-form-name, root.provider-form-kind, root.provider-form-access-key, root.provider-form-secret-key);
                }
            }

            if root.page == Page.provider-discard-confirmation: ProviderDiscardConfirmationPage {
                provider-name: root.provider-form-name;
                cancel => {
                    root.cancel-discard-provider();
                }
                confirm => {
                    root.confirm-discard-provider();
                }
            }

            if root.page == Page.connections: ConnectionsPage {
                connections: root.connections;
                connections-total: root.connections-total;
                providers-total: root.providers-total;
                connection-filter <=> root.connection-filter;
                connections-load-failed: root.connections-load-failed;
                show-connections => {
                    root.show-connections();
                }
                show-add-provider => {
                    root.show-add-provider();
                }
                show-add-connection => {
                    root.show-add-connection();
                }
                set-connection-filter(value) => {
                    root.set-connection-filter(value);
                }
                request-run-connection(id) => {
                    root.request-run-connection(id);
                }
                request-connection-edit(id) => {
                    root.request-connection-edit(id);
                }
                request-connection-delete(id) => {
                    root.request-connection-delete(id);
                }
            }

            if root.page == Page.connection-form: ConnectionFormPage {
                connection-form-id <=> root.connection-form-id;
                connection-form-name <=> root.connection-form-name;
                connection-form-provider <=> root.connection-form-provider;
                connection-form-bucket <=> root.connection-form-bucket;
                connection-form-remote <=> root.connection-form-remote;
                connection-form-local <=> root.connection-form-local;
                connection-form-mode <=> root.connection-form-mode;
                connection-form-retention <=> root.connection-form-retention;
                provider-names: root.provider-names;
                provider-buckets: root.provider-buckets;
                connection-verified-buckets: root.connection-verified-buckets;
                connection-bucket-list-checked: root.connection-bucket-list-checked;
                connection-providers-loading: root.connection-providers-loading;
                connection-providers-load-failed: root.connection-providers-load-failed;
                folder-picker-open: root.folder-picker-open;
                select-local-folder => {
                    root.select-local-folder();
                }
                select-connection-provider(index) => {
                    root.select-connection-provider(index);
                }
                retry-connection-providers => {
                    root.retry-connection-providers();
                }
                save-connection(name, provider, bucket, remote, local, mode, retention) => {
                    root.save-connection(name, provider, bucket, remote, local, mode, retention);
                }
                request-discard-connection => {
                    root.request-discard-connection();
                }
            }

            if root.page == Page.connection-discard-confirmation: ConnectionDiscardConfirmationPage {
                connection-name: root.connection-form-name;
                cancel => {
                    root.cancel-discard-connection();
                }
                confirm => {
                    root.confirm-discard-connection();
                }
            }

            if root.page == Page.privacy: PrivacyPage {
                app-version: root.app-version;
                appearance-preference <=> root.appearance-preference;
                configuration-unavailable: root.configuration-unavailable;
                apply-appearance-preference => {
                    root.apply-appearance-preference();
                }
                change-appearance-preference(index) => {
                    root.change-appearance-preference(index);
                }
                show-diagnostics => {
                    root.show-diagnostics();
                }
                show-welcome => {
                    root.show-welcome();
                }
            }

            if root.page == Page.diagnostics: DiagnosticsPage {
                diagnostic-text: root.diagnostic-text;
                include-paths <=> root.diagnostic-include-paths;
                entry-count: root.diagnostic-entry-count;
                copy-status <=> root.diagnostic-copy-status;
                set-include-paths(value) => {
                    root.set-diagnostic-include-paths(value);
                }
                dismiss => {
                    root.dismiss-diagnostics();
                }
            }

            if root.page == Page.activity: ActivityPage {
                activity-rows: root.activity-rows;
                activity-clearable-count: root.activity-clearable-count;
                clear-completed-activity => {
                    root.clear-completed-activity();
                }
                show-activity-result(id) => {
                    root.show-activity-result(id);
                }
                show-activity-progress(id) => {
                    root.show-activity-progress(id);
                }
                request-cancel-activity(id, title) => {
                    root.request-cancel-activity(id, title);
                }
                remove-queued-activity(id) => {
                    root.remove-queued-activity(id);
                }
            }

            if root.page == Page.activity-result: ActivityResultPage {
                title: root.activity-result-title;
                status: root.activity-result-status;
                summary: root.activity-result-summary;
                completed: root.activity-result-completed-count;
                incomplete: root.activity-result-incomplete-count;
                not-started: root.activity-result-not-started-count;
                details: root.activity-result-details;
                can-retry: root.activity-result-can-retry;
                retry => {
                    root.retry-activity-result();
                }
                dismiss => {
                    root.dismiss-activity-result();
                }
            }

            if root.page == Page.activity-progress: ActivityProgressPage {
                id: root.activity-progress-id;
                title: root.activity-progress-title;
                phase: root.activity-progress-phase;
                summary: root.activity-progress-summary;
                items: root.activity-progress-items;
                bytes: root.activity-progress-bytes;
                path: root.activity-progress-path;
                fraction: root.activity-progress-fraction;
                percent: root.activity-progress-percent;
                dismiss => {
                    root.dismiss-activity-progress();
                }
                request-cancel(id, title) => {
                    root.request-cancel-activity(id, title);
                }
            }

            if root.page == Page.provider-delete: ProviderDeletePage {
                provider-name: root.pending-provider-name;
                connection-count: root.pending-connection-count;
                connections: root.pending-provider-connections;
                cancel => {
                    root.cancel-provider-delete();
                }
                confirm => {
                    root.confirm-provider-delete();
                }
            }
            if root.page == Page.connection-delete: ConnectionDeletePage {
                connection-name: root.pending-connection-name;
                cancel => {
                    root.cancel-connection-delete();
                }
                confirm => {
                    root.confirm-connection-delete();
                }
            }
            if root.page == Page.activity-cancel: ActivityCancelPage {
                activity-name: root.pending-cancel-activity-name;
                dismiss => {
                    root.dismiss-cancel-activity();
                }
                confirm => {
                    root.confirm-cancel-activity();
                }
            }
            if root.page == Page.run-direction: RunDirectionPage {
                connection-name: root.run-connection-name;
                connection-mode: root.run-connection-mode;
                local-endpoint: root.run-local-endpoint;
                remote-endpoint: root.run-remote-endpoint;
                archive-upload-details: root.run-archive-upload-details;
                archive-download-details: root.run-archive-download-details;
                allows-both-ways: root.run-allows-both-ways;
                direction: root.run-direction;
                choose-direction(direction) => {
                    root.choose-run-direction(direction);
                }
                cancel => {
                    root.cancel-run-direction();
                }
                begin-preflight => {
                    root.begin-preflight();
                }
            }
            if root.page == Page.preflight: PreflightPage {
                connection-name: root.run-connection-name;
                connection-mode: root.run-connection-mode;
                local-endpoint: root.run-local-endpoint;
                remote-endpoint: root.run-remote-endpoint;
                direction: root.run-direction;
                loading: root.preflight-loading;
                failed: root.preflight-failed;
                failure-message: root.preflight-failure-message;
                additions: root.preflight-additions;
                overwrites: root.preflight-overwrites;
                deletions: root.preflight-deletions;
                skipped: root.preflight-skipped;
                start-action: root.preflight-start-action;
                requires-mirror-confirmation: root.preflight-requires-mirror-confirmation;
                mirror-confirmed <=> root.preflight-mirror-confirmed;
                item-filter: root.preflight-item-filter;
                items: root.preflight-items;
                visible-items: root.preflight-visible-items;
                start-operation => {
                    root.start-preflight-operation();
                }
                set-item-filter(filter) => {
                    root.set-preflight-item-filter(filter);
                }
                return-to-direction => {
                    root.return-to-run-direction();
                }
                begin-preflight => {
                    root.begin-preflight();
                }
            }
            if root.width < Dimensions.medium-layout-breakpoint: Rectangle {
                accessible-role: navigation;
                accessible-label: "Primary navigation";
                background: Colors.surface;
                border-color: Colors.border;
                border-width: 1px;
                border-radius: 8px;
                min-height: 88px;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            accessible-label: (root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14) ? "Connections, selected" : "Connections";
                            text: "Connections";
                            primary: root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14;
                            enabled: !root.confirmation-open && !root.configuration-unavailable;
                            clicked => {
                                root.request-navigation(4);
                            }
                        }

                        Button {
                            accessible-label: (root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15) ? "Providers, selected" : "Providers";
                            text: "Providers";
                            primary: root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15;
                            enabled: !root.confirmation-open && !root.configuration-unavailable;
                            clicked => {
                                root.request-navigation(1);
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            accessible-label: (root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17) ? "Activity, selected" : "Activity";
                            text: "Activity";
                            primary: root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17;
                            enabled: !root.confirmation-open && !root.configuration-unavailable;
                            clicked => {
                                root.request-navigation(9);
                            }
                        }

                        Button {
                            accessible-label: root.page == 3 ? "Privacy, selected" : "Privacy";
                            text: "Privacy";
                            primary: root.page == 3;
                            enabled: !root.confirmation-open;
                            clicked => {
                                root.request-navigation(3);
                            }
                        }
                    }
                }
            }
        }

        if root.width >= Dimensions.desktop-layout-breakpoint: Rectangle {
            accessible-role: navigation;
            accessible-label: "Primary navigation";
            x: 16px;
            y: 16px;
            width: 144px;
            height: root.height - 32px;
            background: Colors.surface;
            border-color: Colors.border;
            border-width: 1px;
            border-radius: 8px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text {
                    text: "SYNCPAK";
                    color: Colors.border;
                    font-size: 17px;
                    font-weight: 800;
                    letter-spacing: 2px;
                }

                Button {
                    accessible-label: (root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14) ? "Connections, selected" : "Connections";
                    text: "Connections";
                    primary: root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14;
                    enabled: !root.confirmation-open && !root.configuration-unavailable;
                    clicked => {
                        root.request-navigation(4);
                    }
                }

                Button {
                    accessible-label: (root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15) ? "Providers, selected" : "Providers";
                    text: "Providers";
                    primary: root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15;
                    enabled: !root.confirmation-open && !root.configuration-unavailable;
                    clicked => {
                        root.request-navigation(1);
                    }
                }

                Button {
                    accessible-label: (root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17) ? "Activity, selected" : "Activity";
                    text: "Activity";
                    primary: root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17;
                    enabled: !root.confirmation-open && !root.configuration-unavailable;
                    clicked => {
                        root.request-navigation(9);
                    }
                }

                Button {
                    accessible-label: root.page == 3 ? "Privacy, selected" : "Privacy";
                    text: "Privacy";
                    primary: root.page == 3;
                    enabled: !root.confirmation-open;
                    clicked => {
                        root.request-navigation(3);
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }
    }
}
