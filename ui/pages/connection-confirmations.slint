import { PageHeader } from "../components/page-header.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { ExpandedPrimaryActionButton } from "../components/action-buttons.slint";
import { FooterActionRow } from "../components/list-and-action-layouts.slint";

export component ConnectionDiscardConfirmationPage inherits CenteredPageRoot {
    in property <string> connection-name;
    callback cancel();
    callback confirm();

    PageHeader {
        title: "Discard Unsaved Changes?";
        back-label: "Back to editing connection " + root.connection-name;
        back => {
            root.cancel();
        }
    }

    DescriptionLabel {
        text: "Your changes to this connection have not been saved.";
    }

    FooterActionRow {
        ExpandedPrimaryActionButton {
            accessible-label: "Discard changes to connection " + root.connection-name;
            text: "Discard Changes";
            clicked => {
                root.confirm();
            }
        }
    }
}
