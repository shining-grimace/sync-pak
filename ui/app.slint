import { Button, CheckBox, ComboBox, HorizontalBox, LineEdit, ListView, Palette, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";
import { Dimensions } from "dimensions.slint";

export struct ProviderRow {
    id: string,
    name: string,
    kind: string,
    verification: string,
    verifying: bool,
    connection-summary: string,
}

export struct ConnectionRow {
    id: string,
    name: string,
    detail: string,
    mode: int,
    local-path: string,
    provider-name: string,
    remote-location: string,
    archive-retention: string,
}

export struct ActivityRow {
    id: string,
    title: string,
    detail: string,
    status: string,
    progress: string,
    result: string,
    can-cancel: bool,
    can-remove: bool,
    can-view-result: bool,
}

export struct PreflightRow {
    path: string,
    status: string,
    detail: string,
}

export component AppWindow inherits Window {
    in-out property <int> page: 0;
    in-out property <string> app-version;
    in-out property <bool> configuration-unavailable: false;
    in-out property <[ProviderRow]> providers;
    in-out property <bool> providers-load-failed: false;
    in-out property <[ConnectionRow]> connections;
    in-out property <int> connections-total;
    in-out property <int> providers-total;
    in-out property <int> connection-filter: 0;
    in-out property <bool> connections-load-failed: false;
    in-out property <[ActivityRow]> activity-rows;
    in-out property <int> activity-clearable-count: 0;
    in-out property <string> activity-result-title;
    in-out property <string> activity-result-status;
    in-out property <string> activity-result-summary;
    in-out property <[string]> activity-result-details;
    in-out property <string> activity-result-connection-id;
    in-out property <int> activity-result-retry-direction: 0;
    in-out property <bool> activity-result-can-retry: false;
    in-out property <string> activity-progress-id;
    in-out property <string> activity-progress-title;
    in-out property <string> activity-progress-phase;
    in-out property <string> activity-progress-summary;
    in-out property <string> activity-progress-items;
    in-out property <string> activity-progress-bytes;
    in-out property <string> activity-progress-path;
    in-out property <string> active-activity-id;
    in-out property <string> active-activity-title;
    in-out property <string> active-activity-progress;
    in-out property <[string]> provider-names;
    in-out property <[string]> provider-buckets;
    in-out property <[string]> provider-verified-buckets;
    in-out property <bool> provider-bucket-list-empty: false;
    in-out property <string> status-message;
    in-out property <string> notice-message;
    in-out property <string> diagnostic-text;
    in-out property <bool> diagnostic-include-paths;
    in-out property <int> diagnostic-entry-count: 0;
    in-out property <string> diagnostic-copy-status;
    in-out property <int> diagnostic-return-page: 3;
    private property <bool> confirmation-open: page == 6 || page == 7 || page == 12 || page == 13 || page == 14 || page == 15;
    in-out property <string> pending-provider-id;
    in-out property <string> pending-provider-name;
    in-out property <int> pending-connection-count;
    in-out property <[string]> pending-provider-connections;
    in-out property <string> provider-form-id;
    in-out property <string> provider-form-name;
    in-out property <int> provider-form-kind;
    in-out property <string> provider-form-account-id;
    in-out property <string> provider-form-region;
    in-out property <string> provider-form-bucket;
    in-out property <string> provider-form-access-key;
    in-out property <string> provider-form-secret-key;
    in-out property <string> provider-form-endpoint;
    in-out property <string> provider-form-session-token;
    in-out property <string> provider-form-original;
    in-out property <bool> provider-secret-visible: false;
    in-out property <bool> provider-advanced-expanded: false;
    in-out property <bool> provider-verifying: false;
    in-out property <int> provider-verification-generation: 0;
    in-out property <bool> provider-save-after-verification: false;
    in-out property <string> pending-connection-id;
    in-out property <string> pending-connection-name;
    in-out property <string> connection-form-id;
    in-out property <string> connection-form-name;
    in-out property <int> connection-form-provider;
    in-out property <bool> connection-providers-loading: false;
    in-out property <bool> connection-providers-load-failed: false;
    in-out property <string> connection-form-bucket;
    in-out property <[string]> connection-verified-buckets;
    in-out property <bool> connection-bucket-list-checked: false;
    in-out property <string> connection-form-remote;
    in-out property <string> connection-form-local;
    in-out property <int> connection-form-mode;
    in-out property <string> connection-form-retention: "1";
    in-out property <string> connection-form-original;
    in-out property <bool> folder-picker-open: false;
    in-out property <string> run-connection-id;
    in-out property <string> run-connection-name;
    in-out property <string> run-connection-mode;
    in-out property <string> run-local-endpoint;
    in-out property <string> run-remote-endpoint;
    in-out property <string> run-archive-upload-details;
    in-out property <string> run-archive-download-details;
    in-out property <bool> run-allows-both-ways;
    in-out property <int> run-direction: 0;
    in-out property <bool> preflight-loading: false;
    in-out property <bool> preflight-failed: false;
    in-out property <int> preflight-generation: 0;
    in-out property <string> preflight-additions;
    in-out property <string> preflight-overwrites;
    in-out property <string> preflight-deletions;
    in-out property <string> preflight-skipped;
    in-out property <string> preflight-start-action;
    in-out property <bool> preflight-requires-mirror-confirmation: false;
    in-out property <bool> preflight-mirror-confirmed: false;
    in-out property <int> preflight-item-filter: 0;
    in-out property <[PreflightRow]> preflight-items;
    in-out property <[PreflightRow]> preflight-visible-items;
    in-out property <string> pending-cancel-activity-id;
    in-out property <string> pending-cancel-activity-name;
    in-out property <int> pending-navigation-page: -1;
    callback show-providers();
    callback show-connections();
    callback show-add-provider();
    callback show-add-connection();
    callback show-welcome();
    callback retry-configuration();
    callback show-privacy();
    callback show-activity();
    callback request-navigation(int);
    callback complete-pending-navigation();
    callback show-diagnostics();
    callback dismiss-diagnostics();
    callback set-diagnostic-include-paths(bool);
    callback request-provider-delete(string);
    callback request-provider-edit(string);
    callback verify-saved-provider(string);
    callback verify-provider();
    callback save-and-verify-provider();
    callback confirm-provider-delete();
    callback cancel-provider-delete();
    callback request-connection-delete(string);
    callback confirm-connection-delete();
    callback cancel-connection-delete();
    callback request-connection-edit(string);
    callback select-local-folder();
    callback select-connection-provider(int);
    callback retry-connection-providers();
    callback save-provider(string, int, string, string);
    callback request-save-provider();
    callback cancel-save-provider();
    callback request-discard-provider();
    callback confirm-discard-provider();
    callback cancel-discard-provider();
    callback save-connection(string, int, string, string, string, int, string);
    callback request-discard-connection();
    callback confirm-discard-connection();
    callback cancel-discard-connection();
    callback cancel-activity(string);
    callback request-cancel-activity(string, string);
    callback confirm-cancel-activity();
    callback dismiss-cancel-activity();
    callback remove-queued-activity(string);
    callback clear-completed-activity();
    callback show-activity-result(string);
    callback dismiss-activity-result();
    callback retry-activity-result();
    callback show-activity-progress(string);
    callback dismiss-activity-progress();
    callback request-run-connection(string);
    callback choose-run-direction(int);
    callback begin-preflight();
    callback set-preflight-item-filter(int);
    callback cancel-run-direction();
    callback return-to-run-direction();
    callback set-connection-filter(int);

    init => { Palette.color-scheme = ColorScheme.light; }
    title: "SyncPak";
    preferred-width: 900px;
    preferred-height: 620px;
    min-width: 360px;
    min-height: 520px;
    background: #f7f2e8;

    keyboard-shortcuts := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                if root.page == 6 { root.cancel-provider-delete(); return accept; }
                if root.page == 7 { root.cancel-connection-delete(); return accept; }
                if root.page == 8 { root.dismiss-diagnostics(); return accept; }
                if root.page == 10 { root.cancel-run-direction(); return accept; }
                if root.page == 11 { root.return-to-run-direction(); return accept; }
                if root.page == 12 { root.dismiss-cancel-activity(); return accept; }
                if root.page == 16 { root.dismiss-activity-result(); return accept; }
                if root.page == 17 { root.dismiss-activity-progress(); return accept; }
                if root.page == 13 { root.cancel-save-provider(); return accept; }
                if root.page == 14 { root.cancel-discard-connection(); return accept; }
                if root.page == 15 { root.cancel-discard-provider(); return accept; }
                if root.page == 2 { root.request-discard-provider(); return accept; }
                if root.page == 5 { root.request-discard-connection(); return accept; }
            }
            reject
        }

    VerticalBox {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding: 16px;
        padding-left: root.width >= 700px ? 176px : 16px;
        spacing: 16px;

        if root.width >= 520px && root.width < 700px : VerticalBox {
            accessible-role: navigation;
            accessible-label: "Primary navigation";
            spacing: 6px;
            Text { text: "SYNCPAK"; color: #2c2925; font-size: 17px; font-weight: 800; letter-spacing: 2px; }
            HorizontalBox { spacing: 6px;
                Button { accessible-label: (root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14) ? "Connections, selected" : "Connections"; text: "Connections"; primary: root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(4); } }
                Button { accessible-label: (root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15) ? "Providers, selected" : "Providers"; text: "Providers"; primary: root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(1); } }
            }
            HorizontalBox { spacing: 6px;
                Button { accessible-label: (root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17) ? "Activity, selected" : "Activity"; text: "Activity"; primary: root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(9); } }
                Button { accessible-label: root.page == 3 ? "Privacy, selected" : "Privacy"; text: "Privacy"; primary: root.page == 3; enabled: !root.confirmation-open; clicked => { root.request-navigation(3); } }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        if root.status-message != "" : Rectangle {
            accessible-role: region;
            accessible-label: "Action needed";
            background: #fff4f2; border-color: #7b241c; border-width: 1px; border-radius: 8px; min-height: 58px;
            VerticalBox { padding: 10px; spacing: 4px;
                Text { accessible-live-region: assertive; text: "Action needed"; color: #7b241c; font-weight: 700; }
                Text { text: root.status-message; color: #7b241c; wrap: word-wrap; }
                if root.diagnostic-entry-count > 0 : Button { accessible-label: "View redacted diagnostics for this error"; text: "View redacted diagnostics"; clicked => { root.show-diagnostics(); } }
            }
        }

        if root.notice-message != "" : Rectangle {
            accessible-role: region;
            accessible-label: "Update";
            background: #f2fbf3; border-color: #23623a; border-width: 1px; border-radius: 8px; min-height: 48px;
            VerticalBox { padding: 10px; spacing: 4px;
                Text { accessible-live-region: polite; text: "Update"; color: #23623a; font-weight: 700; }
                Text { text: root.notice-message; color: #23623a; wrap: word-wrap; }
            }
        }

        if root.active-activity-id != "" && !root.confirmation-open : Rectangle {
            accessible-role: region;
            accessible-label: "Active operation " + root.active-activity-title;
            background: #2c2925; border-radius: 8px; min-height: 62px;
            VerticalBox { padding: 12px; spacing: 8px;
                VerticalBox { spacing: 2px;
                    Text { text: root.active-activity-title; color: #fffaf0; font-weight: 700; wrap: word-wrap; }
                    Text { accessible-live-region: polite; text: root.active-activity-progress; color: #fffaf0; wrap: word-wrap; }
                }
                if root.width < 420px : VerticalBox { spacing: 8px;
                    Button { accessible-label: "View progress for " + root.active-activity-title; text: "View progress"; clicked => { root.show-activity-progress(root.active-activity-id); } }
                    Button { accessible-label: "Cancel " + root.active-activity-title; text: "Cancel"; clicked => { root.request-cancel-activity(root.active-activity-id, root.active-activity-title); } }
                }
                if root.width >= 420px : HorizontalBox { spacing: 8px;
                    Button { accessible-label: "View progress for " + root.active-activity-title; text: "View progress"; clicked => { root.show-activity-progress(root.active-activity-id); } }
                    Button { accessible-label: "Cancel " + root.active-activity-title; text: "Cancel"; clicked => { root.request-cancel-activity(root.active-activity-id, root.active-activity-title); } }
                }
            }
        }

        if root.page == 0 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px;
            HorizontalBox {
                alignment: center;
                VerticalBox {
                    preferred-width: Dimensions.welcome-content-max-width;
                    max-width: Dimensions.welcome-content-max-width;
                    horizontal-stretch: 1;
                    spacing: 14px;
                    alignment: center;
                    Text { text: "Your files, your cloud."; color: #171512; font-size: 36px; font-weight: 800; horizontal-alignment: center; wrap: word-wrap; }
                    Text { text: "SyncPak copies folders directly between this device and cloud providers you choose. SyncPak does not operate an intermediary file service."; color: #454039; font-size: 18px; horizontal-alignment: center; wrap: word-wrap; max-width: Dimensions.welcome-content-max-width; }
                    Rectangle { height: 16px; background: transparent; }
                    Rectangle {
                        accessible-role: region; accessible-label: "Protected credentials";
                        background: #fffaf0; border-color: #2c2925; border-width: 2px; border-radius: 12px; max-width: Dimensions.welcome-content-max-width; min-height: 92px;
                        Text { text: "Your provider credentials are protected using this device's secure storage and are sent only to that provider."; color: #2c2925; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; x: 24px; width: parent.width - 48px; height: parent.height; }
                    }
                    Rectangle {
                        accessible-role: region; accessible-label: "Choose how each connection behaves";
                        background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 12px; max-width: Dimensions.welcome-content-max-width; min-height: 106px;
                        VerticalBox { padding: 14px; spacing: 5px;
                            Text { text: "Choose how each connection behaves"; font-weight: 700; horizontal-alignment: center; }
                            Text { text: "Add-only — Copy new files without overwriting or deleting anything."; color: #454039; wrap: word-wrap; }
                            Text { text: "Mirror — Attempt to make a destination match its source after previewing destructive changes. Any issues are listed when the operation finishes."; color: #454039; wrap: word-wrap; }
                            Text { text: "Archive — Create timestamped ZIP archives and keep the number you choose."; color: #454039; wrap: word-wrap; }
                        }
                    }
                    Rectangle { height: 16px; background: transparent; }
                    if root.configuration-unavailable : Rectangle { accessible-role: region; accessible-label: "Configuration storage unavailable"; background: #fff4f2; border-color: #7b241c; border-width: 1px; border-radius: 12px; max-width: Dimensions.welcome-content-max-width; min-height: 122px;
                        VerticalBox { padding: 14px; spacing: 6px;
                            Text { text: "Configuration storage is unavailable"; color: #7b241c; font-weight: 700; horizontal-alignment: center; wrap: word-wrap; }
                            Text { text: "SyncPak cannot save providers or connections until its configuration storage is available."; color: #7b241c; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalBox { alignment: center; FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: retry-configuration; init => { self.focus(); } } retry-configuration := Button { accessible-label: "Retry opening configuration storage"; text: "Retry"; primary: true; clicked => { root.retry-configuration(); } } }
                        }
                    }
                    if !root.configuration-unavailable : HorizontalBox { alignment: center; FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: welcome-add-provider; init => { self.focus(); } } welcome-add-provider := Button { accessible-label: "Add your first provider"; text: "Add your first provider"; primary: true; preferred-width: Dimensions.welcome-action-max-width; max-width: Dimensions.welcome-action-max-width; clicked => { root.show-add-provider(); } } }
                    HorizontalBox { alignment: center; Button { accessible-label: "Read how SyncPak protects your privacy"; text: "Read how SyncPak protects your privacy"; preferred-width: Dimensions.welcome-action-max-width; max-width: Dimensions.welcome-action-max-width; clicked => { root.show-privacy(); } } }
                }
            }
            }
        }

        if root.page == 1 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Providers"; color: #171512; font-size: 32px; font-weight: 800; }
            Text { text: "Provider credentials are kept in this device's protected storage."; color: #454039; wrap: word-wrap; }
            if root.providers-load-failed : VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: providers-retry; init => { self.focus(); } }
                accessible-role: region;
                accessible-label: "Providers unavailable";
                spacing: 8px;
                Text { text: "Providers unavailable"; color: #7b241c; font-size: 22px; font-weight: 700; }
                Text { text: "SyncPak could not load providers. Check configuration storage and try again."; color: #7b241c; wrap: word-wrap; }
                providers-retry := Button { accessible-label: "Retry loading providers"; text: "Retry"; primary: true; clicked => { root.show-providers(); } }
            }
            if !root.providers-load-failed : VerticalBox {
            spacing: 12px;
            FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: provider-add; init => { self.focus(); } }
            provider-add := Button { accessible-label: "Add a provider"; text: "Add provider"; primary: true; clicked => { root.show-add-provider(); } }
            if root.providers.length == 0 : VerticalBox {
                spacing: 8px;
                Text { text: "No providers yet"; font-size: 22px; font-weight: 700; }
                Text { text: "Add credentials for Cloudflare R2, Backblaze B2, or AWS S3."; wrap: word-wrap; }
            }
            if root.providers.length > 0 : ListView {
                accessible-label: "Configured providers";
                height: 260px;
                vertical-scrollbar-policy: always-on;
                for provider in root.providers : Rectangle {
                    accessible-role: list-item;
                    accessible-label: provider.name + ". " + provider.kind + ". " + provider.verification + ". " + provider.connection-summary;
                    background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: root.width < 420px ? 168px : 82px;
                    VerticalBox { padding: 10px; spacing: 8px;
                        VerticalBox { spacing: 2px;
                            Text { text: provider.name; font-weight: 700; wrap: word-wrap; }
                            Text { text: provider.kind + " · " + provider.verification; color: #454039; }
                            Text { text: provider.connection-summary; color: #454039; wrap: word-wrap; }
                        }
                        if root.width < 420px : VerticalBox { spacing: 8px;
                            Button { accessible-label: "Verify provider " + provider.name; text: provider.verifying ? "Verifying…" : "Verify"; enabled: !provider.verifying; clicked => { root.verify-saved-provider(provider.id); } }
                            Button { accessible-label: "Edit provider " + provider.name; text: "Edit"; clicked => { root.request-provider-edit(provider.id); } }
                            Button { accessible-label: "Delete provider " + provider.name; text: "Delete"; clicked => { root.request-provider-delete(provider.id); } }
                        }
                        if root.width >= 420px : HorizontalBox { spacing: 8px;
                            Button { accessible-label: "Verify provider " + provider.name; text: provider.verifying ? "Verifying…" : "Verify"; enabled: !provider.verifying; clicked => { root.verify-saved-provider(provider.id); } }
                            Button { accessible-label: "Edit provider " + provider.name; text: "Edit"; clicked => { root.request-provider-edit(provider.id); } }
                            Button { accessible-label: "Delete provider " + provider.name; text: "Delete"; clicked => { root.request-provider-delete(provider.id); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            }
            }
        }

        if root.page == 2 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 10px;
            Text { text: root.provider-form-id == "" ? "Add provider" : "Edit " + root.provider-form-name; color: #171512; font-size: 32px; font-weight: 800; wrap: word-wrap; }
            Text { text: "Credentials are saved in this device's protected storage only when you save this provider."; wrap: word-wrap; }
            if root.provider-form-id != "" : Text { text: "To update this provider, enter its credentials again. SyncPak never displays saved secret values."; color: #454039; wrap: word-wrap; }
            FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: provider-name; init => { self.focus(); } }
            Text { text: "Provider name"; font-weight: 700; }
            provider-name := LineEdit { accessible-label: "Provider name"; placeholder-text: "For example, Personal S3"; text <=> root.provider-form-name; enabled: !root.provider-verifying; }
            Text { text: "Provider type"; font-weight: 700; }
            provider-kind := ComboBox { accessible-label: "Provider type"; model: ["Cloudflare R2", "Backblaze B2", "AWS S3"]; current-index <=> root.provider-form-kind; enabled: !root.provider-verifying; }
            if root.provider-form-kind == 0 : VerticalBox {
                spacing: 4px;
                Text { text: "Account ID"; font-weight: 700; }
                LineEdit { accessible-label: "Cloudflare account ID"; placeholder-text: "Cloudflare account ID"; text <=> root.provider-form-account-id; enabled: !root.provider-verifying; }
            }
            if root.provider-form-kind != 0 : VerticalBox {
                spacing: 4px;
                Text { text: "Region"; font-weight: 700; }
                LineEdit { accessible-label: "Region"; placeholder-text: "For example, ap-southeast-2"; text <=> root.provider-form-region; enabled: !root.provider-verifying; }
            }
            Text { text: "Default bucket (optional)"; font-weight: 700; }
            LineEdit { accessible-label: "Default bucket"; placeholder-text: "Used and locked for connections that select this provider"; text <=> root.provider-form-bucket; enabled: !root.provider-verifying; }
            if root.provider-verified-buckets.length > 0 : VerticalBox {
                spacing: 4px;
                Text { text: "Verified available buckets"; color: #454039; }
                ComboBox {
                    accessible-label: "Verified available buckets";
                    model: root.provider-verified-buckets;
                    enabled: !root.provider-verifying;
                    selected => { root.provider-form-bucket = root.provider-verified-buckets[self.current-index]; }
                }
            }
            if !root.provider-verifying && root.provider-bucket-list-empty : Text {
                text: "These credentials verified successfully, but no buckets were visible. Enter a bucket manually if its access is restricted.";
                color: #454039; wrap: word-wrap;
            }
            Text { text: "When set, new and edited connections using this provider use this bucket and cannot change it."; color: #454039; wrap: word-wrap; }
            if root.provider-form-kind == 1 : Text { text: "Create an application key in Backblaze B2; the same key pair works with its S3-compatible API. Do not use the master application key. Enter its S3 endpoint under Advanced."; color: #454039; wrap: word-wrap; }
            Text { text: root.provider-form-kind == 1 ? "Key ID" : "Access key ID"; font-weight: 700; }
            access-key := LineEdit { accessible-label: root.provider-form-kind == 1 ? "Key ID" : "Access key ID"; placeholder-text: root.provider-form-kind == 1 ? "Key ID" : "Access key ID"; text <=> root.provider-form-access-key; enabled: !root.provider-verifying; }
            Text { text: root.provider-form-kind == 1 ? "Application key" : "Secret access key"; font-weight: 700; }
            HorizontalBox {
                LineEdit { accessible-label: root.provider-form-kind == 1 ? "Application key" : "Secret access key"; placeholder-text: root.provider-form-kind == 1 ? "Application key" : "Secret access key"; text <=> root.provider-form-secret-key; input-type: root.provider-secret-visible ? text : password; horizontal-stretch: 1; enabled: !root.provider-verifying; }
                Button { accessible-label: (root.provider-secret-visible ? "Hide " : "Reveal ") + (root.provider-form-kind == 1 ? "application key" : "secret access key"); text: root.provider-secret-visible ? "Hide" : "Reveal"; enabled: !root.provider-verifying; clicked => { root.provider-secret-visible = !root.provider-secret-visible; } }
            }
            if root.provider-secret-visible : Text { text: "Make sure nobody else can see your screen."; color: #7b241c; wrap: word-wrap; }
            Button { accessible-label: root.provider-advanced-expanded ? "Hide advanced provider settings" : "Show advanced provider settings"; text: root.provider-advanced-expanded ? "Hide advanced" : "Advanced"; enabled: !root.provider-verifying; clicked => { root.provider-advanced-expanded = !root.provider-advanced-expanded; } }
            if root.provider-advanced-expanded : VerticalBox {
                spacing: 4px;
                Text { text: "Custom endpoint"; font-weight: 700; }
                LineEdit { accessible-label: "Custom endpoint"; placeholder-text: "Optional S3-compatible endpoint"; text <=> root.provider-form-endpoint; enabled: !root.provider-verifying; }
                Text { text: "Session token"; font-weight: 700; }
                LineEdit { accessible-label: "Session token"; placeholder-text: "Optional temporary session token"; text <=> root.provider-form-session-token; input-type: root.provider-secret-visible ? text : password; enabled: !root.provider-verifying; }
                Text { text: "Use this only when your provider issued a temporary session credential."; color: #454039; wrap: word-wrap; }
            }
            Text { text: "Verify checks the credentials and lists available buckets without saving or changing cloud data."; color: #454039; wrap: word-wrap; }
            if root.provider-verifying : Text { accessible-live-region: polite; text: "Checking these settings without changing cloud data…"; color: #454039; wrap: word-wrap; }
            VerticalBox {
                Button { accessible-label: "Back to providers"; text: "Back"; clicked => { root.request-discard-provider(); } }
                Button { accessible-label: "Save " + root.provider-form-name + " without verifying"; text: "Save without verifying"; enabled: !root.provider-verifying; clicked => { root.request-save-provider(); } }
                Button { accessible-label: "Verify settings for " + root.provider-form-name; text: "Verify settings"; enabled: !root.provider-verifying; clicked => { root.verify-provider(); } }
                Button { accessible-label: "Save and verify " + root.provider-form-name; text: root.provider-verifying ? "Verifying…" : "Save and verify"; primary: true; enabled: !root.provider-verifying; clicked => { root.save-and-verify-provider(); } }
            }
            }
        }

        if root.page == 13 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Save without verifying?"; color: #171512; font-size: 28px; font-weight: 800; }
            Text { text: "This provider may not work until its credentials and access are verified."; wrap: word-wrap; }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: continue-saving-provider; init => { self.focus(); } }
                continue-saving-provider := Button { accessible-label: "Continue editing provider " + root.provider-form-name; text: "Continue editing"; clicked => { root.cancel-save-provider(); } }
                Button { accessible-label: "Save provider " + root.provider-form-name + " without verifying"; text: "Save " + root.provider-form-name + " without verifying"; primary: true; clicked => { root.save-provider(root.provider-form-name, root.provider-form-kind, root.provider-form-access-key, root.provider-form-secret-key); } }
            }
            }
        }

        if root.page == 15 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Discard unsaved changes?"; color: #171512; font-size: 28px; font-weight: 800; }
            Text { text: "Your changes to this provider have not been saved."; wrap: word-wrap; }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: continue-discarding-provider; init => { self.focus(); } }
                continue-discarding-provider := Button { accessible-label: "Continue editing provider " + root.provider-form-name; text: "Continue editing"; clicked => { root.cancel-discard-provider(); } }
                Button { accessible-label: "Discard changes to provider " + root.provider-form-name; text: "Discard changes"; primary: true; clicked => { root.confirm-discard-provider(); } }
            }
            }
        }

        if root.page == 4 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Connections"; color: #171512; font-size: 32px; font-weight: 800; }
            Text { text: "A connection links a local folder with a folder in one cloud bucket."; color: #454039; wrap: word-wrap; }
            if root.connections-load-failed : VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: connections-retry; init => { self.focus(); } }
                accessible-role: region;
                accessible-label: "Connections unavailable";
                spacing: 8px;
                Text { text: "Connections unavailable"; color: #7b241c; font-size: 22px; font-weight: 700; }
                Text { text: "SyncPak could not load connections. Check configuration storage and try again."; color: #7b241c; wrap: word-wrap; }
                connections-retry := Button { accessible-label: "Retry loading connections"; text: "Retry"; primary: true; clicked => { root.show-connections(); } }
            }
            if !root.connections-load-failed : VerticalBox {
            spacing: 12px;
            if root.providers-total == 0 : VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: connection-add-provider; init => { self.focus(); } }
                connection-add-provider := Button { accessible-label: "Add a provider before creating a connection"; text: "Add provider"; primary: true; clicked => { root.show-add-provider(); } }
            }
            if root.providers-total > 0 : VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: connection-new; init => { self.focus(); } }
                connection-new := Button { accessible-label: "Create a new connection"; text: "New connection"; primary: true; clicked => { root.show-add-connection(); } }
            }
            VerticalBox { accessible-role: region; accessible-label: "Filter connections by mode"; spacing: 6px;
                Text { text: "Filter by mode"; color: #454039; font-weight: 700; }
                HorizontalBox { spacing: 6px;
                    Button { accessible-label: root.connection-filter == 0 ? "All connections, selected" : "Show all connections"; text: "All"; primary: root.connection-filter == 0; clicked => { root.set-connection-filter(0); } }
                    Button { accessible-label: root.connection-filter == 1 ? "Add-only connections, selected" : "Show add-only connections"; text: "Add-only"; primary: root.connection-filter == 1; clicked => { root.set-connection-filter(1); } }
                }
                HorizontalBox { spacing: 6px;
                    Button { accessible-label: root.connection-filter == 2 ? "Mirror connections, selected" : "Show mirror connections"; text: "Mirror"; primary: root.connection-filter == 2; clicked => { root.set-connection-filter(2); } }
                    Button { accessible-label: root.connection-filter == 3 ? "Archive connections, selected" : "Show archive connections"; text: "Archive"; primary: root.connection-filter == 3; clicked => { root.set-connection-filter(3); } }
                }
            }
            if root.connections-total > 0 : Text {
                text: root.connections.length == root.connections-total ? "Showing all " + root.connections-total + (root.connections-total == 1 ? " connection." : " connections.") : "Showing " + root.connections.length + " of " + root.connections-total + " connections.";
                color: #454039; wrap: word-wrap;
            }
            if root.connections.length == 0 : VerticalBox {
                spacing: 8px;
                Text { text: root.connections-total == 0 ? "No connections yet" : "No matching connections"; font-size: 22px; font-weight: 700; }
                if root.connections-total == 0 && root.providers-total == 0 : Text { text: "Add a cloud provider, then create a connection to choose what to copy."; wrap: word-wrap; }
                if root.connections-total == 0 && root.providers-total > 0 : Text { text: "Create a connection to link a local folder with cloud storage."; wrap: word-wrap; }
                if root.connections-total > 0 : Text { text: "Choose another filter or create a new connection."; wrap: word-wrap; }
                if root.connections-total > 0 && root.connection-filter != 0 : Button { accessible-label: "Remove the connection filter and show all connections"; text: "Show all connections"; primary: true; clicked => { root.set-connection-filter(0); } }
            }
            if root.connections.length > 0 : ListView {
                height: 280px;
                vertical-scrollbar-policy: always-on;
                for connection in root.connections : Rectangle {
                    accessible-role: list-item;
                    accessible-label: connection.name + ". " + connection.detail + ". On this device: " + connection.local-path + ". In " + connection.provider-name + ": " + connection.remote-location;
                    background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: root.width < 420px ? 250px : 98px;
                        VerticalBox { padding: 10px; spacing: 8px;
                            VerticalBox { spacing: 3px;
                                Text { text: connection.name; font-weight: 700; wrap: word-wrap; }
                                Text { text: connection.detail; color: #454039; }
                                if root.width < 520px : VerticalBox { spacing: 6px;
                                    VerticalBox { spacing: 2px;
                                        Text { text: "On this device"; color: #454039; font-weight: 700; }
                                        Text { text: connection.local-path; color: #454039; wrap: word-wrap; }
                                    }
                                    Text { accessible-label: connection.mode == 2 ? "Archive destination" : "Connected folders"; text: connection.mode == 2 ? "↓ Archive destination" : "↕ Connected folders"; color: #2c2925; font-weight: 700; }
                                    VerticalBox { spacing: 2px;
                                        Text { text: "In " + connection.provider-name; color: #454039; font-weight: 700; wrap: word-wrap; }
                                        Text { text: connection.remote-location; color: #454039; wrap: word-wrap; }
                                    }
                                }
                                if root.width >= 520px : HorizontalBox { spacing: 8px;
                                    VerticalBox { horizontal-stretch: 1; spacing: 2px;
                                        Text { text: "On this device"; color: #454039; font-weight: 700; }
                                        Text { text: connection.local-path; color: #454039; wrap: word-wrap; }
                                    }
                                    Text { accessible-label: connection.mode == 2 ? "Archive destination" : "Connected folders"; text: connection.mode == 2 ? "▣" : "⇄"; color: #2c2925; font-size: 22px; vertical-alignment: center; }
                                    VerticalBox { horizontal-stretch: 1; spacing: 2px;
                                        Text { text: "In " + connection.provider-name; color: #454039; font-weight: 700; wrap: word-wrap; }
                                        Text { text: connection.remote-location; color: #454039; wrap: word-wrap; }
                                    }
                                }
                                if connection.mode == 2 : Text { text: "Keeps the last " + connection.archive-retention + " archives"; color: #454039; }
                            }
                        if root.width < 420px : VerticalBox { spacing: 8px;
                            Button { accessible-label: "Run connection " + connection.name; text: "Run"; primary: true; clicked => { root.request-run-connection(connection.id); } }
                            Button { accessible-label: "Edit connection " + connection.name; text: "Edit"; clicked => { root.request-connection-edit(connection.id); } }
                            Button { accessible-label: "Delete connection " + connection.name; text: "Delete"; clicked => { root.request-connection-delete(connection.id); } }
                        }
                        if root.width >= 420px : HorizontalBox { spacing: 8px;
                            Button { accessible-label: "Run connection " + connection.name; text: "Run"; primary: true; clicked => { root.request-run-connection(connection.id); } }
                            Button { accessible-label: "Edit connection " + connection.name; text: "Edit"; clicked => { root.request-connection-edit(connection.id); } }
                            Button { accessible-label: "Delete connection " + connection.name; text: "Delete"; clicked => { root.request-connection-delete(connection.id); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            }
            }
        }

        if root.page == 5 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 10px;
            Text { text: root.connection-form-id == "" ? "New connection" : "Edit " + root.connection-form-name; color: #171512; font-size: 32px; font-weight: 800; wrap: word-wrap; }
            Text { text: "Save only stores this connection. It does not transfer files."; wrap: word-wrap; }
            VerticalBox { accessible-role: region; accessible-label: "Connection identity and cloud destination"; spacing: 6px;
            FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: connection-name; init => { self.focus(); } }
            Text { text: "Connection name"; font-weight: 700; }
            connection-name := LineEdit { accessible-label: "Connection name"; placeholder-text: "For example, Photos backup"; text <=> root.connection-form-name; }
            Text { text: "Used in the connection list and archive filenames."; color: #454039; wrap: word-wrap; }
            Text { text: "Provider"; font-weight: 700; }
            connection-provider := ComboBox { accessible-label: root.connection-providers-loading ? "Loading providers" : (root.connection-providers-load-failed ? "Providers unavailable" : (root.provider-names.length == 0 ? "Provider; add a provider first" : "Provider")); model: root.provider-names; enabled: !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length > 0; current-index <=> root.connection-form-provider; selected => { root.select-connection-provider(self.current-index); } }
            if root.connection-providers-loading : Text { accessible-live-region: polite; text: "Loading providers…"; color: #454039; wrap: word-wrap; }
            if root.connection-providers-load-failed : VerticalBox { spacing: 6px;
                Text { accessible-live-region: assertive; text: "SyncPak could not load providers. Check configuration storage and try again."; color: #7b241c; wrap: word-wrap; }
                Button { accessible-label: "Retry loading providers for this connection"; text: root.connection-providers-loading ? "Retrying…" : "Retry loading providers"; enabled: !root.connection-providers-loading; clicked => { root.retry-connection-providers(); } }
            }
            if !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length == 0 : Text { text: "Add a provider before creating a connection."; color: #7b241c; wrap: word-wrap; }
            Text { text: "Bucket"; font-weight: 700; }
            connection-bucket := LineEdit { accessible-label: connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] != "" ? "Bucket locked to the provider default" : "Bucket"; placeholder-text: "Bucket name"; text <=> root.connection-form-bucket; enabled: connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == ""; }
            if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] != "" && root.connection-form-bucket == root.provider-buckets[connection-provider.current-index] : Text {
                text: "This provider locks connections to its default bucket: " + root.provider-buckets[connection-provider.current-index] + ".";
                color: #454039; wrap: word-wrap;
            }
            if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] != "" && root.connection-form-bucket != root.provider-buckets[connection-provider.current-index] : Text {
                text: "This existing connection keeps its saved bucket. Saving this form will not automatically adopt the provider's current default bucket.";
                color: #454039; wrap: word-wrap;
            }
            if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "" && root.connection-bucket-list-checked && root.connection-verified-buckets.length > 0 : VerticalBox {
                spacing: 4px;
                Text { text: "Buckets verified this session"; color: #454039; }
                ComboBox {
                    accessible-label: "Buckets verified this session";
                    model: root.connection-verified-buckets;
                    selected => { root.connection-form-bucket = root.connection-verified-buckets[self.current-index]; }
                }
            }
            if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "" && root.connection-bucket-list-checked && root.connection-verified-buckets.length == 0 : Text {
                text: "These credentials were verified, but no buckets were visible. Enter the bucket name manually if access is restricted.";
                color: #454039; wrap: word-wrap;
            }
            if connection-provider.current-index >= 0 && connection-provider.current-index < root.provider-buckets.length && root.provider-buckets[connection-provider.current-index] == "" && !root.connection-bucket-list-checked : Text {
                text: "Enter the bucket name manually, or verify this provider to select buckets visible to its current credentials.";
                color: #454039; wrap: word-wrap;
            }
            Text { text: "Remote folder"; font-weight: 700; }
            connection-remote := LineEdit { accessible-label: "Remote folder"; placeholder-text: "Leave empty for the bucket root"; text <=> root.connection-form-remote; }
            Text { text: "Leave empty to use the root of the bucket."; color: #454039; wrap: word-wrap; }
            }
            Text { text: "Local folder"; font-weight: 700; }
            VerticalBox { spacing: 6px;
                connection-local := LineEdit { accessible-label: "Local folder"; placeholder-text: "Full local folder path"; text <=> root.connection-form-local; enabled: !root.folder-picker-open; }
                Text { text: "Selecting a folder lets SyncPak inventory and transfer files only for this connection. Your system may ask you to allow access to the folder you choose."; color: #454039; wrap: word-wrap; }
                Button { accessible-label: root.folder-picker-open ? "Folder selection in progress" : "Select local folder"; text: root.folder-picker-open ? "Selecting folder…" : "Select folder"; enabled: !root.folder-picker-open; clicked => { root.select-local-folder(); } }
                if root.folder-picker-open : Text { accessible-live-region: polite; text: "Waiting for folder selection…"; color: #454039; wrap: word-wrap; }
            }
            Text { text: "Mode"; font-weight: 700; }
            connection-mode := ComboBox { accessible-label: "Mode"; model: ["Add-only", "Mirror", "Archive"]; current-index <=> root.connection-form-mode; }
            if connection-mode.current-index == 0 : Text {
                text: "Copies files that exist only at the source. Existing changed files are skipped, and nothing is overwritten or deleted.";
                color: #454039; wrap: word-wrap;
            }
            if connection-mode.current-index == 1 : Text {
                text: "Attempts to make the destination match the source. Overwrites and deletions are always shown for confirmation before the run starts. Any files or metadata that cannot be matched are listed when the operation finishes.";
                color: #454039; wrap: word-wrap;
            }
            if connection-mode.current-index == 2 : VerticalBox {
                spacing: 4px;
                Text { text: "Creates a timestamped ZIP from the source and stores it at the destination. Older archives are removed according to this connection's retention setting."; color: #454039; wrap: word-wrap; }
                Text { text: "Keep last N archives"; font-weight: 700; }
                connection-retention := LineEdit { accessible-label: "Keep last N archives"; text <=> root.connection-form-retention; }
                Text { text: "After a new archive is saved successfully, older archives made by this connection are deleted until this many remain."; color: #454039; wrap: word-wrap; }
            }
            VerticalBox {
                Button { accessible-label: "Back to connections"; text: "Back"; clicked => { root.request-discard-connection(); } }
                Button { accessible-label: "Save connection " + root.connection-form-name + " without transferring files"; text: "Save connection"; primary: true; enabled: !root.connection-providers-loading && !root.connection-providers-load-failed && root.provider-names.length > 0; clicked => { root.save-connection(connection-name.text, connection-provider.current-index, connection-bucket.text, connection-remote.text, connection-local.text, connection-mode.current-index, root.connection-form-retention); } }
            }
            }
        }

        if root.page == 14 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Discard unsaved changes?"; color: #171512; font-size: 28px; font-weight: 800; }
            Text { text: "Your changes to this connection have not been saved."; wrap: word-wrap; }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: continue-editing-connection; init => { self.focus(); } }
                continue-editing-connection := Button { accessible-label: "Continue editing connection " + root.connection-form-name; text: "Continue editing"; clicked => { root.cancel-discard-connection(); } }
                Button { accessible-label: "Discard changes to connection " + root.connection-form-name; text: "Discard " + root.connection-form-name + " changes"; primary: true; clicked => { root.confirm-discard-connection(); } }
            }
            }
        }

        if root.page == 3 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Privacy & About"; color: #171512; font-size: 32px; font-weight: 800; }
            Rectangle { accessible-role: region; accessible-label: "Direct transfers"; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 72px;
                VerticalBox { padding: 12px; spacing: 4px; Text { text: "Direct transfers"; font-size: 20px; font-weight: 700; } Text { text: "Your files move directly between this device and the cloud provider you configured. SyncPak does not receive or host them."; wrap: word-wrap; } }
            }
            Rectangle { accessible-role: region; accessible-label: "Protected credentials"; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 72px;
                VerticalBox { padding: 12px; spacing: 4px; Text { text: "Protected credentials"; font-size: 20px; font-weight: 700; } Text { text: "Provider credentials are stored using this device's protected facilities and are retrieved only when SyncPak connects to that provider."; wrap: word-wrap; } }
            }
            Rectangle { accessible-role: region; accessible-label: "Data on this device"; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 72px;
                VerticalBox { padding: 12px; spacing: 4px; Text { text: "Data on this device"; font-size: 20px; font-weight: 700; } Text { text: "Connection settings are stored locally. Activity is kept in memory and cleared when SyncPak exits."; wrap: word-wrap; } }
            }
            Rectangle { accessible-role: region; accessible-label: "File encryption"; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 72px;
                VerticalBox { padding: 12px; spacing: 4px; Text { text: "File encryption"; font-size: 20px; font-weight: 700; } Text { text: "SyncPak does not encrypt file contents before transfer. Your provider and HTTPS connection may provide other forms of encryption."; wrap: word-wrap; } }
            }
            Text { text: "SyncPak " + root.app-version; color: #454039; }
            VerticalBox { accessible-role: region; accessible-label: "Privacy and source links"; spacing: 6px;
                Text { text: "Links"; font-weight: 700; }
                Button { accessible-label: "Open SyncPak source code in your browser"; text: "Source code"; clicked => { Platform.open-url("https://github.com/shining-grimace/sync-pak"); } }
                Button { accessible-label: "Open Cloudflare privacy policy in your browser"; text: "Cloudflare privacy policy"; clicked => { Platform.open-url("https://www.cloudflare.com/privacypolicy/"); } }
                Button { accessible-label: "Open Backblaze privacy policy in your browser"; text: "Backblaze privacy policy"; clicked => { Platform.open-url("https://www.backblaze.com/company/policies/privacy.html"); } }
                Button { accessible-label: "Open Amazon privacy notice in your browser"; text: "AWS privacy notice"; clicked => { Platform.open-url("https://www.amazon.com/gp/help/customer/display.html?nodeId=201909010"); } }
                Text { text: "SyncPak's privacy policy and open-source licence notices will be published before release."; color: #454039; wrap: word-wrap; }
            }
            FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: privacy-diagnostics; init => { self.focus(); } }
            privacy-diagnostics := Button { accessible-label: "View redacted diagnostics with credentials excluded"; text: "View redacted diagnostics"; clicked => { root.show-diagnostics(); } }
            Button { accessible-label: "Back to welcome"; text: "Back"; clicked => { root.show-welcome(); } }
            }
        }

        if root.page == 8 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Diagnostics"; color: #171512; font-size: 32px; font-weight: 800; }
            Text { text: "This report excludes provider credentials. Paths are hidden unless you choose to include them."; wrap: word-wrap; }
            Text { accessible-live-region: polite; text: root.diagnostic-entry-count == 0 ? "No errors have been recorded in this session." : root.diagnostic-entry-count == 1 ? "1 error has been recorded in this session." : root.diagnostic-entry-count + " errors have been recorded in this session."; color: #454039; wrap: word-wrap; }
            include-paths := CheckBox { text: "Include file and folder paths"; checked <=> root.diagnostic-include-paths; toggled => { root.diagnostic-copy-status = ""; root.set-diagnostic-include-paths(self.checked); } }
            if root.diagnostic-include-paths : Text { accessible-live-region: assertive; text: "Paths can contain personal information. Include them only when you trust the person receiving the report. Turning this option off removes paths from the report immediately."; color: #7b241c; wrap: word-wrap; }
            Text { text: "Use Copy report, or select the report and use your system copy shortcut."; color: #454039; wrap: word-wrap; }
            Rectangle { background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 220px;
                diagnostic-report := TextEdit {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: parent.height - 24px;
                    accessible-label: "Redacted diagnostics report. Select text and use your system copy shortcut to copy it.";
                    text: root.diagnostic-text;
                    read-only: true;
                    wrap: word-wrap;
                }
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: diagnostic-report; init => { self.focus(); } }
            }
            Button {
                accessible-label: root.diagnostic-include-paths ? "Copy diagnostics report with file and folder paths" : "Copy redacted diagnostics report";
                text: root.diagnostic-include-paths ? "Copy report with paths" : "Copy redacted report";
                clicked => {
                    diagnostic-report.select-all();
                    diagnostic-report.copy();
                    root.diagnostic-copy-status = root.diagnostic-include-paths ? "Diagnostics report with paths copied." : "Redacted diagnostics report copied.";
                }
            }
            if root.diagnostic-copy-status != "" : Text { accessible-live-region: polite; text: root.diagnostic-copy-status; color: #23623a; wrap: word-wrap; }
            Button { accessible-label: "Return to the previous screen"; text: "Back"; clicked => { root.dismiss-diagnostics(); } }
            }
        }

        if root.page == 9 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Activity"; color: #171512; font-size: 32px; font-weight: 800; }
            Text { text: "Queued and completed operations appear here until SyncPak exits."; color: #454039; wrap: word-wrap; }
            if root.activity-clearable-count > 0 : VerticalBox {
                spacing: 4px;
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: clear-completed-activity; init => { self.focus(); } }
                clear-completed-activity := Button { accessible-label: "Clear " + root.activity-clearable-count + " completed activity entries"; text: root.activity-clearable-count == 1 ? "Clear completed entry" : "Clear completed entries"; clicked => { root.clear-completed-activity(); } }
                Text { text: "Removes " + root.activity-clearable-count + (root.activity-clearable-count == 1 ? " completed, failed, or cancelled entry." : " completed, failed, or cancelled entries."); color: #454039; wrap: word-wrap; }
            }
            if root.activity-rows.length == 0 : Rectangle {
                accessible-role: region;
                accessible-label: "No activity this time";
                background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 130px;
                VerticalBox { padding: 20px; spacing: 8px; alignment: center;
                    Text { text: "No activity this time"; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Queued and completed operations will appear here until SyncPak exits."; color: #454039; wrap: word-wrap; horizontal-alignment: center; }
                }
            }
            if root.activity-rows.length > 0 : ListView {
                accessible-label: "Current activity";
                height: 240px;
                vertical-scrollbar-policy: always-on;
                for activity in root.activity-rows : Rectangle {
                    accessible-role: list-item;
                    accessible-label: activity.title + ". " + activity.status + ". " + activity.detail + (activity.progress != "" ? ". Progress: " + activity.progress : "") + (activity.result != "" ? ". Result: " + activity.result : "");
                    background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: root.width < 420px ? 166px : 86px;
                    VerticalBox { padding: 12px; spacing: 8px;
                        VerticalBox { spacing: 2px;
                            Text { text: activity.title + " · " + activity.status; font-weight: 700; wrap: word-wrap; }
                            Text { text: activity.detail; color: #454039; wrap: word-wrap; }
                            if activity.progress != "" : Text { text: "Progress: " + activity.progress; color: #454039; wrap: word-wrap; }
                            if activity.result != "" : Text { text: "Result: " + activity.result; color: #454039; wrap: word-wrap; }
                        }
                        if (activity.can-cancel || activity.can-remove || activity.can-view-result) && root.width < 420px : VerticalBox {
                            spacing: 8px;
                            if activity.can-view-result : Button { accessible-label: "View result for " + activity.title; text: "View result"; clicked => { root.show-activity-result(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "View progress for " + activity.title; text: "View progress"; clicked => { root.show-activity-progress(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "Cancel " + activity.title; text: "Cancel"; clicked => { root.request-cancel-activity(activity.id, activity.title); } }
                            if activity.can-remove : Button { accessible-label: "Remove " + activity.title; text: "Remove"; clicked => { root.remove-queued-activity(activity.id); } }
                        }
                        if (activity.can-cancel || activity.can-remove || activity.can-view-result) && root.width >= 420px : HorizontalBox {
                            spacing: 8px;
                            if activity.can-view-result : Button { accessible-label: "View result for " + activity.title; text: "View result"; clicked => { root.show-activity-result(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "View progress for " + activity.title; text: "View progress"; clicked => { root.show-activity-progress(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "Cancel " + activity.title; text: "Cancel"; clicked => { root.request-cancel-activity(activity.id, activity.title); } }
                            if activity.can-remove : Button { accessible-label: "Remove " + activity.title; text: "Remove"; clicked => { root.remove-queued-activity(activity.id); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            }
        }

        if root.page == 16 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Result: " + root.activity-result-title; color: #171512; font-size: 32px; font-weight: 800; wrap: word-wrap; }
            Text { text: root.activity-result-status; font-weight: 700; }
            Text { text: root.activity-result-summary; color: #454039; wrap: word-wrap; }
            if root.activity-result-details.length == 0 : Text {
                text: "No actions were started for this operation.";
                color: #454039; wrap: word-wrap;
            }
            if root.activity-result-details.length > 0 : VerticalBox {
                spacing: 6px;
                Text { text: "Action outcomes"; font-weight: 700; }
                ListView {
                    accessible-label: "Action outcomes";
                    height: 240px;
                    vertical-scrollbar-policy: always-on;
                    for detail in root.activity-result-details : Text {
                        accessible-role: list-item;
                        text: detail; wrap: word-wrap;
                    }
                }
            }
            if root.activity-result-can-retry : Button {
                accessible-label: "Retry " + root.activity-result-title + " with a new preflight review";
                text: "Retry with a new preflight";
                primary: true;
                clicked => { root.retry-activity-result(); }
            }
            FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: activity-result-back; init => { self.focus(); } }
            activity-result-back := Button { accessible-label: "Return to activity"; text: "Back to activity"; clicked => { root.dismiss-activity-result(); } }
            }
        }

        if root.page == 17 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Progress: " + root.activity-progress-title; color: #171512; font-size: 32px; font-weight: 800; wrap: word-wrap; }
            Text { accessible-live-region: polite; text: root.activity-progress-phase; font-weight: 700; }
            Text { text: root.activity-progress-summary; color: #454039; wrap: word-wrap; }
            Rectangle { accessible-role: region; accessible-label: "Operation progress"; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 120px;
                VerticalBox { padding: 12px; spacing: 6px;
                    Text { text: root.activity-progress-items; wrap: word-wrap; }
                    Text { text: root.activity-progress-bytes; wrap: word-wrap; }
                    Text { text: "Current item"; color: #454039; font-weight: 700; }
                    Text { text: root.activity-progress-path; wrap: word-wrap; }
                }
            }
            Text { text: "Minimize leaves this operation running. You can return from Activity at any time."; color: #454039; wrap: word-wrap; }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: minimize-progress; init => { self.focus(); } }
                minimize-progress := Button { accessible-label: "Minimize progress for " + root.activity-progress-title; text: "Minimize"; clicked => { root.dismiss-activity-progress(); } }
                Button { accessible-label: "Cancel " + root.activity-progress-title; text: "Cancel operation"; primary: true; clicked => { root.request-cancel-activity(root.activity-progress-id, root.activity-progress-title); } }
            }
            }
        }

        if root.page == 6 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Delete " + root.pending-provider-name + "?"; color: #171512; font-size: 28px; font-weight: 800; wrap: word-wrap; }
            Text { text: "This permanently deletes its protected credentials and " + root.pending-connection-count + (root.pending-connection-count == 1 ? " dependent connection from SyncPak." : " dependent connections from SyncPak.") + " It does not delete local or cloud files."; wrap: word-wrap; }
            if root.pending-provider-connections.length > 0 : VerticalBox {
                spacing: 3px;
                Text { text: "Connections that will be deleted"; font-weight: 700; }
                ListView {
                    accessible-label: "Connections that will be deleted";
                    height: 180px;
                    vertical-scrollbar-policy: always-on;
                    for connection-name in root.pending-provider-connections : Text {
                        accessible-role: list-item;
                        accessible-label: connection-name;
                        text: "• " + connection-name;
                        color: #454039;
                        wrap: word-wrap;
                    }
                }
            }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: keep-provider; init => { self.focus(); } }
                keep-provider := Button { accessible-label: "Keep provider " + root.pending-provider-name; text: "Cancel"; clicked => { root.cancel-provider-delete(); } }
                Button { accessible-label: "Delete provider " + root.pending-provider-name + " and " + root.pending-connection-count + (root.pending-connection-count == 1 ? " connection" : " connections"); text: "Delete " + root.pending-provider-name + " and " + root.pending-connection-count + (root.pending-connection-count == 1 ? " connection" : " connections"); primary: true; clicked => { root.confirm-provider-delete(); } }
            }
            }
        }

        if root.page == 7 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Delete " + root.pending-connection-name + "?"; color: #171512; font-size: 28px; font-weight: 800; wrap: word-wrap; }
            Text { text: "This removes the connection from SyncPak. It does not delete local or cloud files."; wrap: word-wrap; }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: keep-connection; init => { self.focus(); } }
                keep-connection := Button { accessible-label: "Keep connection " + root.pending-connection-name; text: "Cancel"; clicked => { root.cancel-connection-delete(); } }
                Button { accessible-label: "Delete connection " + root.pending-connection-name; text: "Delete " + root.pending-connection-name; primary: true; clicked => { root.confirm-connection-delete(); } }
            }
            }
        }
        if root.page == 12 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Cancel " + root.pending-cancel-activity-name + "?"; color: #171512; font-size: 28px; font-weight: 800; wrap: word-wrap; }
            Text { text: "Completed changes will not be undone. Work that has not started will be skipped."; wrap: word-wrap; }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: keep-running; init => { self.focus(); } }
                keep-running := Button { accessible-label: "Keep " + root.pending-cancel-activity-name + " running"; text: "Keep running"; clicked => { root.dismiss-cancel-activity(); } }
                Button { accessible-label: "Cancel operation " + root.pending-cancel-activity-name; text: "Cancel " + root.pending-cancel-activity-name; primary: true; clicked => { root.confirm-cancel-activity(); } }
            }
            }
        }
        if root.page == 10 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: "Run " + root.run-connection-name; color: #171512; font-size: 32px; font-weight: 800; wrap: word-wrap; }
            Text { text: root.run-connection-mode + " connection"; color: #454039; }
            if root.run-direction == 0 && root.run-archive-upload-details != "" : Rectangle {
                background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 66px;
                Text { text: root.run-archive-upload-details; color: #454039; wrap: word-wrap; x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px; }
            }
            if root.run-direction == 1 && root.run-archive-download-details != "" : Rectangle {
                background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 66px;
                Text { text: root.run-archive-download-details; color: #454039; wrap: word-wrap; x: 12px; y: 12px; width: parent.width - 24px; height: parent.height - 24px; }
            }
            Rectangle { accessible-role: region; accessible-label: "Upload direction. Source: " + root.run-local-endpoint + ". Destination: " + root.run-remote-endpoint; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 132px;
                VerticalBox { padding: 12px; spacing: 4px;
                    Text { text: "Upload"; font-weight: 700; }
                    Text { text: "Use the local folder as the source and cloud storage as the destination."; wrap: word-wrap; }
                    Text { text: "Source: " + root.run-local-endpoint; color: #454039; wrap: word-wrap; }
                    Text { text: "Destination: " + root.run-remote-endpoint; color: #454039; wrap: word-wrap; }
                    FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: choose-upload; init => { self.focus(); } }
                    choose-upload := Button { accessible-label: root.run-direction == 0 ? "Upload direction, selected" : "Choose upload direction"; text: "Choose upload"; primary: root.run-direction == 0; clicked => { root.choose-run-direction(0); } }
                }
            }
            Rectangle { accessible-role: region; accessible-label: "Download direction. Source: " + root.run-remote-endpoint + ". Destination: " + root.run-local-endpoint; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 132px;
                VerticalBox { padding: 12px; spacing: 4px;
                    Text { text: "Download"; font-weight: 700; }
                    Text { text: "Use cloud storage as the source and the local folder as the destination."; wrap: word-wrap; }
                    Text { text: "Source: " + root.run-remote-endpoint; color: #454039; wrap: word-wrap; }
                    Text { text: "Destination: " + root.run-local-endpoint; color: #454039; wrap: word-wrap; }
                    Button { accessible-label: root.run-direction == 1 ? "Download direction, selected" : "Choose download direction"; text: "Choose download"; primary: root.run-direction == 1; clicked => { root.choose-run-direction(1); } }
                }
            }
            if root.run-allows-both-ways : Rectangle { accessible-role: region; accessible-label: "Both ways direction between " + root.run-local-endpoint + " and " + root.run-remote-endpoint; background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 132px;
                VerticalBox { padding: 12px; spacing: 4px;
                    Text { text: "Both ways"; font-weight: 700; }
                    Text { text: "Copy files found on only one side to the other. Changed files are skipped."; wrap: word-wrap; }
                    Text { text: "This device: " + root.run-local-endpoint; color: #454039; wrap: word-wrap; }
                    Text { text: "Cloud storage: " + root.run-remote-endpoint; color: #454039; wrap: word-wrap; }
                    Button { accessible-label: root.run-direction == 2 ? "Both-ways direction, selected" : "Choose both-ways direction"; text: "Choose both ways"; primary: root.run-direction == 2; clicked => { root.choose-run-direction(2); } }
                }
            }
            Text { text: "Continue performs a read-only inventory and shows the complete plan before any files can change."; color: #454039; wrap: word-wrap; }
            VerticalBox {
                Button { accessible-label: "Cancel run for " + root.run-connection-name; text: "Cancel"; clicked => { root.cancel-run-direction(); } }
                Button { accessible-label: "Continue to preflight for " + root.run-connection-name; text: "Continue to preflight"; primary: true; clicked => { root.begin-preflight(); } }
            }
            }
        }
        if root.page == 11 : ScrollView {
            vertical-scrollbar-policy: always-on;
            VerticalBox { width: parent.width - 12px; spacing: 12px;
            Text { text: root.preflight-failed ? "This operation cannot start" : (root.preflight-loading ? "Checking before anything changes" : (root.preflight-requires-mirror-confirmation ? "Review mirror changes" : "Ready to start")); color: #171512; font-size: 32px; font-weight: 800; wrap: word-wrap; }
            Text { text: "Reviewing " + root.run-connection-name + " · " + root.run-connection-mode + " · " + (root.run-direction == 0 ? "Upload" : (root.run-direction == 1 ? "Download" : "Both ways")); color: #454039; wrap: word-wrap; }
            Rectangle { accessible-role: region; accessible-label: root.run-direction == 2 ? "Comparing both sides: " + root.run-local-endpoint + " and " + root.run-remote-endpoint : "Comparing source " + (root.run-direction == 0 ? root.run-local-endpoint : root.run-remote-endpoint) + " with destination " + (root.run-direction == 0 ? root.run-remote-endpoint : root.run-local-endpoint); background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 78px;
                VerticalBox { padding: 12px; spacing: 4px;
                    if root.run-direction != 2 : Text { text: "Source: " + (root.run-direction == 0 ? root.run-local-endpoint : root.run-remote-endpoint); color: #454039; wrap: word-wrap; }
                    if root.run-direction != 2 : Text { text: "Destination: " + (root.run-direction == 0 ? root.run-remote-endpoint : root.run-local-endpoint); color: #454039; wrap: word-wrap; }
                    if root.run-direction == 2 : Text { text: "This device: " + root.run-local-endpoint; color: #454039; wrap: word-wrap; }
                    if root.run-direction == 2 : Text { text: "Cloud storage: " + root.run-remote-endpoint; color: #454039; wrap: word-wrap; }
                }
            }
            if root.preflight-loading : Text { accessible-live-region: polite; text: "Listing files…"; font-weight: 700; }
            Text { text: "No files are changed during this check."; color: #454039; wrap: word-wrap; }
            if root.preflight-loading : Rectangle { background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 110px;
                Text { text: "Preflight will compare the endpoints above, then show additions, overwrites, deletions, and skipped files before anything starts."; wrap: word-wrap; x: 16px; y: 16px; width: parent.width - 32px; height: parent.height - 32px; }
            }
            if root.preflight-failed : Text { text: "Resolve the issues below, then run the connection again. No files were changed."; color: #7b241c; wrap: word-wrap; }
            if !root.preflight-loading && !root.preflight-failed : VerticalBox {
                spacing: 8px;
                VerticalBox {
                    accessible-role: region;
                    accessible-label: "Plan summary: " + root.preflight-additions + ", " + root.preflight-overwrites + ", " + root.preflight-deletions + ", " + root.preflight-skipped;
                    spacing: 4px;
                    if root.width < 520px : VerticalBox { spacing: 3px;
                        Text { text: root.preflight-additions; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.preflight-overwrites; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.preflight-deletions; font-weight: 700; wrap: word-wrap; }
                        Text { text: root.preflight-skipped; font-weight: 700; wrap: word-wrap; }
                    }
                    if root.width >= 520px : HorizontalBox { spacing: 8px;
                        Text { text: root.preflight-additions; font-weight: 700; }
                        Text { text: root.preflight-overwrites; font-weight: 700; }
                    }
                    if root.width >= 520px : HorizontalBox { spacing: 8px;
                        Text { text: root.preflight-deletions; font-weight: 700; }
                        Text { text: root.preflight-skipped; font-weight: 700; }
                    }
                }
                if root.preflight-requires-mirror-confirmation : Rectangle {
                    accessible-role: region;
                    accessible-label: "Destructive mirror changes";
                    background: #fff4f2; border-color: #7b241c; border-width: 1px; border-radius: 8px; min-height: 86px;
                    VerticalBox { padding: 12px; spacing: 5px;
                        Text { text: "Destructive mirror changes"; color: #7b241c; font-weight: 700; }
                        Text { accessible-live-region: assertive; text: "SyncPak will attempt to make the destination match the source. Review every overwrite and deletion before continuing."; color: #7b241c; wrap: word-wrap; }
                        Text { text: root.preflight-overwrites + " · " + root.preflight-deletions; color: #7b241c; wrap: word-wrap; }
                    }
                }
                if root.preflight-items.length == 0 : Text {
                    text: "No changes are needed. The reviewed local folder and cloud storage already match for this direction.";
                    color: #23623a; wrap: word-wrap;
                }
                if root.preflight-items.length > 0 : Text {
                    text: root.preflight-item-filter == 0 ? "Reviewing " + root.preflight-items.length + " planned file changes." : (root.preflight-item-filter == 1 ? "Reviewing planned additions." : (root.preflight-item-filter == 2 ? "Reviewing planned overwrites." : (root.preflight-item-filter == 3 ? "Reviewing planned deletions." : "Reviewing planned warnings.")));
                    color: #454039; wrap: word-wrap;
                }
                if root.preflight-items.length > 0 : VerticalBox {
                    accessible-role: region;
                    accessible-label: "Filter planned file changes";
                    spacing: 6px;
                    Text { text: "Show planned changes"; color: #454039; font-weight: 700; }
                    HorizontalBox { spacing: 6px;
                        Button { accessible-label: root.preflight-item-filter == 0 ? "All planned changes, selected" : "Show all planned changes"; text: "All"; primary: root.preflight-item-filter == 0; clicked => { root.set-preflight-item-filter(0); } }
                        Button { accessible-label: root.preflight-item-filter == 1 ? "New files, selected" : "Show new files"; text: "New"; primary: root.preflight-item-filter == 1; clicked => { root.set-preflight-item-filter(1); } }
                        Button { accessible-label: root.preflight-item-filter == 2 ? "Overwrites, selected" : "Show overwrites"; text: "Overwrites"; primary: root.preflight-item-filter == 2; clicked => { root.set-preflight-item-filter(2); } }
                    }
                    HorizontalBox { spacing: 6px;
                        Button { accessible-label: root.preflight-item-filter == 3 ? "Deletions, selected" : "Show deletions"; text: "Deletions"; primary: root.preflight-item-filter == 3; clicked => { root.set-preflight-item-filter(3); } }
                        Button { accessible-label: root.preflight-item-filter == 4 ? "Warnings, selected" : "Show warnings"; text: "Warnings"; primary: root.preflight-item-filter == 4; clicked => { root.set-preflight-item-filter(4); } }
                    }
                }
                if root.preflight-items.length > 0 : ListView {
                    accessible-label: root.preflight-item-filter == 0 ? "All planned file changes" : (root.preflight-item-filter == 1 ? "Planned new files" : (root.preflight-item-filter == 2 ? "Planned overwrites" : (root.preflight-item-filter == 3 ? "Planned deletions" : "Planned warnings")));
                    height: 180px;
                    vertical-scrollbar-policy: always-on;
                    for item in root.preflight-visible-items : VerticalBox {
                        accessible-role: list-item;
                        accessible-label: item.status + ": " + item.path + ". " + item.detail;
                        spacing: 4px;
                        if root.width < 420px : Text { text: item.status; color: #454039; font-weight: 700; wrap: word-wrap; }
                        if root.width >= 420px : HorizontalBox { spacing: 8px;
                            Text { text: item.status; width: 110px; color: #454039; }
                            Text { text: item.path; horizontal-stretch: 1; wrap: word-wrap; }
                        }
                        if root.width < 420px : Text { text: item.path; wrap: word-wrap; }
                        VerticalBox { spacing: 2px;
                            Text { text: item.detail; color: #454039; wrap: word-wrap; }
                        }
                    }
                }
                if root.preflight-items.length > 0 && root.preflight-visible-items.length == 0 : Rectangle {
                    accessible-role: region;
                    accessible-label: "No entries in the selected planned change category";
                    background: #fffaf0; border-color: #2c2925; border-width: 1px; border-radius: 8px; min-height: 74px;
                    Text {
                        text: root.preflight-item-filter == 1 ? "No new files are planned." : (root.preflight-item-filter == 2 ? "No overwrites are planned." : (root.preflight-item-filter == 3 ? "No deletions are planned." : "No warnings are listed in this review."));
                        color: #454039;
                        wrap: word-wrap;
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        height: parent.height - 24px;
                    }
                }
                if root.preflight-requires-mirror-confirmation : CheckBox {
                    accessible-label: "Acknowledge the listed overwrites and deletions";
                    text: "I understand that the listed destination files will be overwritten or deleted.";
                    checked <=> root.preflight-mirror-confirmed;
                }
                if root.preflight-requires-mirror-confirmation : Text {
                    accessible-live-region: polite;
                    text: root.preflight-mirror-confirmed ? "Destructive mirror changes acknowledged." : "Acknowledge the listed changes before this mirror can start.";
                    color: root.preflight-mirror-confirmed ? #23623a : #7b241c;
                    wrap: word-wrap;
                }
                Button {
                    accessible-label: (root.preflight-requires-mirror-confirmation && !root.preflight-mirror-confirmed) ? root.preflight-start-action + " is unavailable until destructive changes are acknowledged" : root.preflight-start-action + " is unavailable because transfer execution is not connected";
                    text: root.preflight-start-action + " (unavailable)";
                    enabled: false;
                }
                Text { text: root.preflight-requires-mirror-confirmation && !root.preflight-mirror-confirmed ? "Transfer execution stays unavailable until you acknowledge the destructive changes above." : "Transfer execution is not connected in this build. This completed review remains read-only."; color: #454039; wrap: word-wrap; }
            }
            VerticalBox {
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: preflight-back; init => { self.focus(); } }
                preflight-back := Button { accessible-label: "Return to direction selection for " + root.run-connection-name; text: "Back"; clicked => { root.return-to-run-direction(); } }
                if root.preflight-failed : Button { accessible-label: "Try the preflight check again"; text: "Try again"; primary: true; clicked => { root.begin-preflight(); } }
                if !root.preflight-loading && !root.preflight-failed : Button { accessible-label: "Refresh the read-only preflight review"; text: "Refresh review"; clicked => { root.begin-preflight(); } }
            }
            }
        }
        Rectangle { vertical-stretch: 1; }
        if root.width < 520px : Rectangle {
            accessible-role: navigation;
            accessible-label: "Primary navigation";
            background: #fffaf0;
            border-color: #2c2925;
            border-width: 1px;
            border-radius: 8px;
            min-height: 88px;
            VerticalBox {
                padding: 8px;
                spacing: 6px;
                HorizontalBox { spacing: 6px;
                    Button { accessible-label: (root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14) ? "Connections, selected" : "Connections"; text: "Connections"; primary: root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(4); } }
                    Button { accessible-label: (root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15) ? "Providers, selected" : "Providers"; text: "Providers"; primary: root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(1); } }
                }
                HorizontalBox { spacing: 6px;
                    Button { accessible-label: (root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17) ? "Activity, selected" : "Activity"; text: "Activity"; primary: root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(9); } }
                    Button { accessible-label: root.page == 3 ? "Privacy, selected" : "Privacy"; text: "Privacy"; primary: root.page == 3; enabled: !root.confirmation-open; clicked => { root.request-navigation(3); } }
                }
            }
        }
    }
    if root.width >= 700px : Rectangle {
        accessible-role: navigation;
        accessible-label: "Primary navigation";
        x: 16px;
        y: 16px;
        width: 144px;
        height: root.height - 32px;
        background: #fffaf0;
        border-color: #2c2925;
        border-width: 1px;
        border-radius: 8px;
        VerticalBox {
            padding: 12px;
            spacing: 8px;
            Text { text: "SYNCPAK"; color: #2c2925; font-size: 17px; font-weight: 800; letter-spacing: 2px; }
            Button { accessible-label: (root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14) ? "Connections, selected" : "Connections"; text: "Connections"; primary: root.page == 4 || root.page == 5 || root.page == 7 || root.page == 10 || root.page == 11 || root.page == 14; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(4); } }
            Button { accessible-label: (root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15) ? "Providers, selected" : "Providers"; text: "Providers"; primary: root.page == 1 || root.page == 2 || root.page == 6 || root.page == 13 || root.page == 15; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(1); } }
            Button { accessible-label: (root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17) ? "Activity, selected" : "Activity"; text: "Activity"; primary: root.page == 8 || root.page == 9 || root.page == 12 || root.page == 16 || root.page == 17; enabled: !root.confirmation-open && !root.configuration-unavailable; clicked => { root.request-navigation(9); } }
            Button { accessible-label: root.page == 3 ? "Privacy, selected" : "Privacy"; text: "Privacy"; primary: root.page == 3; enabled: !root.confirmation-open; clicked => { root.request-navigation(3); } }
            Rectangle { vertical-stretch: 1; }
        }
    }
    }
}
