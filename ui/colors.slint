export global Colors {
    in-out property <bool> dark-mode: false;

    out property <brush> background: dark-mode ? #1e1b22 : #fef8e6;
    out property <brush> background-trim: dark-mode ? #1d1726 : #ccc7b9;
    out property <brush> primary-accent: dark-mode ? #b58fef : #371070;
    out property <brush> secondary-accent: dark-mode ? #efb68f : #703610;
    out property <brush> primary-trim: dark-mode ? #7240bf : #6c20df;
    out property <brush> secondary-trim: dark-mode ? #bf7340 : #bf7240;

    out property <brush> danger: dark-mode ? #ffb4ab : #901c1c;
    out property <brush> danger-surface: dark-mode ? #5c1715 : #ffc0c0;
    out property <brush> success: dark-mode ? #87d89a : #1c801c;
    out property <brush> success-surface: dark-mode ? #183d24 : #c0f0c0;
}
