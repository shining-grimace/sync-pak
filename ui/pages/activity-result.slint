import { Dimensions } from "../dimensions.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { InfoCard } from "../components/cards.slint";
import { PrimaryActionButton, SecondaryActionButton } from "../components/action-buttons.slint";
import { ListItem, ListView } from "../components/list-and-action-layouts.slint";

export component ActivityResultPage inherits CenteredPageRoot {
    in property <string> title;
    in property <string> status;
    in property <string> summary;
    in property <int> completed;
    in property <int> incomplete;
    in property <int> not-started;
    in property <[string]> details;
    in property <bool> can-retry;
    callback retry();
    callback dismiss();
    HeadingLabel {
        text: "Result: " + root.title;
        wrap: word-wrap;
    }

    SectionHeadingLabel {
        text: root.status;
    }

    DescriptionLabel {
        text: root.summary;
    }

    InfoCard {
        accessible-role: region;
        accessible-label: "Outcome totals: " + root.completed + " completed, " + root.incomplete + " incomplete, " + root.not-started + " not started";
        min-height: root.width < Dimensions.narrow-layout-breakpoint ? 126px : 68px;
        if root.width < Dimensions.narrow-layout-breakpoint: VerticalLayout {
            spacing: Dimensions.card-element-spacing;
            DescriptionLabel {
                text: root.completed + " completed";
            }

            DescriptionLabel {
                text: root.incomplete + " incomplete";
            }

            DescriptionLabel {
                text: root.not-started + " not started";
            }
        }
        if root.width >= Dimensions.narrow-layout-breakpoint: HorizontalLayout {
            spacing: Dimensions.card-element-spacing;
            DescriptionLabel {
                text: root.completed + " completed";
            }

            DescriptionLabel {
                text: root.incomplete + " incomplete";
            }

            DescriptionLabel {
                text: root.not-started + " not started";
            }
        }
    }

    if root.details.length == 0: DescriptionLabel {
        text: "No actions were started for this operation.";
    }
    if root.details.length > 0: VerticalLayout {
        spacing: 6px;
        SectionHeadingLabel {
            text: "Action outcomes";
            font-weight: 700;
        }

        ListView {
            accessible-label: "Action outcomes";
            height: 240px;
            vertical-scrollbar-policy: always-on;
            for detail in root.details: ListItem {
                DescriptionLabel {
                    accessible-role: list-item;
                    text: detail;
                }
            }
        }
    }
    if root.can-retry: PrimaryActionButton {
        accessible-label: "Retry " + root.title + " with a new preflight review";
        text: "Retry Run";
        clicked => {
            root.retry();
        }
    }
    SecondaryActionButton {
        accessible-label: "Return to activity";
        text: "Activity";
        clicked => {
            root.dismiss();
        }
    }
}
