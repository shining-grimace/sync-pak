import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { ConnectionRow } from "../models.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { InfoCard } from "../components/cards.slint";
import { ErrorHeadingLabel } from "../components/error-heading-label.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import {
    CardPrimaryActionButton,
    CardSecondaryActionButton,
    PrimaryActionButton,
    RadioButton,
} from "../components/action-buttons.slint";
import { ContentGroup, ListItem, ListView } from "../components/list-and-action-layouts.slint";

export component ConnectionsPage inherits CenteredPageRoot {
    in property <[ConnectionRow]> connections;
    in property <int> connections-total;
    in property <int> providers-total;
    in-out property <int> connection-filter;
    in property <bool> connections-load-failed;
    callback show-connections();
    callback show-add-provider();
    callback show-add-connection();
    callback set-connection-filter(int);
    callback request-run-connection(string);
    callback verify-saved-connection(string);
    callback request-connection-edit(string);
    callback request-connection-delete(string);
    fill-height: true;
    mouse-drag-pan-enabled: false;

    HeadingLabel {
        text: "Connections";
    }

    DescriptionLabel {
        text: "A connection links a local folder with a folder in one cloud bucket.";
    }

    if root.connections-load-failed: VerticalLayout {
        FocusScope {
            width: 0px;
            height: 0px;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            forward-focus: connections-retry;
            init => {
                self.focus();
            }
        }

        accessible-role: region;
        accessible-label: "Connections unavailable";
        spacing: Dimensions.element-gap;
        ErrorHeadingLabel {
            text: "Connections unavailable";
        }

        ErrorLabel {
            text: "SyncPak could not load connections. Check configuration storage and try again.";
        }

        connections-retry := PrimaryActionButton {
            accessible-label: "Retry loading connections";
            text: "Retry";
            clicked => {
                root.show-connections();
            }
        }
    }
    if !root.connections-load-failed: VerticalLayout {
        vertical-stretch: 1;
        spacing: Dimensions.section-gap;
        if root.providers-total == 0: VerticalLayout {
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                forward-focus: connection-add-provider;
                init => {
                    self.focus();
                }
            }

            connection-add-provider := PrimaryActionButton {
                accessible-label: "Add a provider before creating a connection";
                text: "Add Provider";
                clicked => {
                    root.show-add-provider();
                }
            }
        }
        if root.providers-total > 0: VerticalLayout {
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                forward-focus: connection-new;
                init => {
                    self.focus();
                }
            }

            connection-new := PrimaryActionButton {
                accessible-label: "Create a new connection";
                text: "New Connection";
                clicked => {
                    root.show-add-connection();
                }
            }
        }
        ContentGroup {
            accessible-role: region;
            accessible-label: "Filter connections by mode";
            spacing: Dimensions.element-gap;
            SectionHeadingLabel {
                text: "Filter by mode";
            }

            HorizontalLayout {
                spacing: Dimensions.element-gap;
                RadioButton {
                    accessible-label: root.connection-filter == 0 ? "All connections, selected" : "Show all connections";
                    text: "All";
                    selected: root.connection-filter == 0;
                    clicked => {
                        root.set-connection-filter(0);
                    }
                }

                RadioButton {
                    accessible-label: root.connection-filter == 1 ? "Add-only connections, selected" : "Show add-only connections";
                    text: "Add-only";
                    selected: root.connection-filter == 1;
                    clicked => {
                        root.set-connection-filter(1);
                    }
                }
            }

            HorizontalLayout {
                spacing: Dimensions.element-gap;
                RadioButton {
                    accessible-label: root.connection-filter == 2 ? "Mirror connections, selected" : "Show mirror connections";
                    text: "Mirror";
                    selected: root.connection-filter == 2;
                    clicked => {
                        root.set-connection-filter(2);
                    }
                }

                RadioButton {
                    accessible-label: root.connection-filter == 3 ? "Archive connections, selected" : "Show archive connections";
                    text: "Archive";
                    selected: root.connection-filter == 3;
                    clicked => {
                        root.set-connection-filter(3);
                    }
                }
            }
        }

        if root.connections-total > 0: DescriptionLabel {
            text: root.connections.length == root.connections-total ? "Showing all " + root.connections-total + (root.connections-total == 1 ? " connection." : " connections.") : "Showing " + root.connections.length + " of " + root.connections-total + " connections.";
        }
        if root.connections.length == 0: ContentGroup {
            spacing: Dimensions.element-gap;
            SectionHeadingLabel {
                text: root.connections-total == 0 ? "No connections yet" : "No matching connections";
            }

            if root.connections-total == 0 && root.providers-total == 0: DescriptionLabel {
                text: "Add a cloud provider, then create a connection to choose what to copy.";
            }
            if root.connections-total == 0 && root.providers-total > 0: DescriptionLabel {
                text: "Create a connection to link a local folder with cloud storage.";
            }
            if root.connections-total > 0: DescriptionLabel {
                text: "Choose another filter or create a new connection.";
            }
            if root.connections-total > 0 && root.connection-filter != 0: PrimaryActionButton {
                accessible-label: "Remove the connection filter and show all connections";
                text: "Show All";
                clicked => {
                    root.set-connection-filter(0);
                }
            }
        }
        if root.connections.length > 0: ListView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: always-on;
            for connection in root.connections: ListItem {
                width: parent.width;
                InfoCard {
                    accessible-role: list-item;
                    accessible-label: connection.name + ". " + connection.detail + ". " + connection.verification + ". On this device: " + connection.local-path + ". In " + connection.provider-name + ": " + connection.remote-location;
                    baseline-height: root.width < Dimensions.medium-layout-breakpoint ? 300px : 98px;
                    VerticalLayout {
                    spacing: Dimensions.card-element-spacing;
                    VerticalLayout {
                        spacing: Dimensions.card-element-spacing;
                        SectionHeadingLabel {
                            text: connection.name;
                        }

                        DescriptionLabel {
                            text: connection.detail + " · " + connection.verification;
                            color: Colors.secondary;
                        }

                        if root.width < Dimensions.medium-layout-breakpoint: VerticalLayout {
                            spacing: Dimensions.card-element-spacing;
                            VerticalLayout {
                                spacing: Dimensions.card-element-spacing;
                                DescriptionLabel {
                                    text: "On this device";
                                }

                                DescriptionLabel {
                                    text: connection.local-path;
                                }
                            }

                            DescriptionLabel {
                                accessible-label: connection.mode == 2 ? "Archive destination" : "Connected folders";
                                text: connection.mode == 2 ? "↓ Archive destination" : "↕ Connected folders";
                            }

                            VerticalLayout {
                                spacing: Dimensions.card-element-spacing;
                                DescriptionLabel {
                                    text: "In " + connection.provider-name;
                                }

                                DescriptionLabel {
                                    text: connection.remote-location;
                                }
                            }
                        }
                        if root.width >= Dimensions.medium-layout-breakpoint: HorizontalLayout {
                            spacing: Dimensions.card-element-spacing;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Dimensions.card-element-spacing;
                                DescriptionLabel {
                                    text: "On this device";
                                }

                                DescriptionLabel {
                                    text: connection.local-path;
                                }
                            }

                            SectionHeadingLabel {
                                accessible-label: connection.mode == 2 ? "Archive destination" : "Connected folders";
                                text: connection.mode == 2 ? "▣" : "⇄";
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: Dimensions.card-element-spacing;
                                DescriptionLabel {
                                    text: "In " + connection.provider-name;
                                }

                                DescriptionLabel {
                                    text: connection.remote-location;
                                }
                            }
                        }
                        if connection.mode == 2: DescriptionLabel {
                            text: "Keeps the last " + connection.archive-retention + " archives";
                        }
                    }

                    if root.width < Dimensions.medium-layout-breakpoint: VerticalLayout {
                        spacing: Dimensions.card-element-spacing;
                        CardPrimaryActionButton {
                            accessible-label: "Run connection " + connection.name;
                            text: "Run";
                            clicked => {
                                root.request-run-connection(connection.id);
                            }
                        }

                        CardSecondaryActionButton {
                            accessible-label: "Verify connection " + connection.name;
                            text: connection.verifying ? "Verifying…" : "Verify";
                            enabled: !connection.verifying;
                            clicked => {
                                root.verify-saved-connection(connection.id);
                            }
                        }

                        CardSecondaryActionButton {
                            accessible-label: "Edit connection " + connection.name;
                            text: "Edit";
                            clicked => {
                                root.request-connection-edit(connection.id);
                            }
                        }

                        CardSecondaryActionButton {
                            accessible-label: "Delete connection " + connection.name;
                            text: "Delete";
                            clicked => {
                                root.request-connection-delete(connection.id);
                            }
                        }
                    }
                    if root.width >= Dimensions.medium-layout-breakpoint: HorizontalLayout {
                        spacing: Dimensions.card-element-spacing;
                        CardPrimaryActionButton {
                            accessible-label: "Run connection " + connection.name;
                            text: "Run";
                            clicked => {
                                root.request-run-connection(connection.id);
                            }
                        }

                        CardSecondaryActionButton {
                            accessible-label: "Verify connection " + connection.name;
                            text: connection.verifying ? "Verifying…" : "Verify";
                            enabled: !connection.verifying;
                            clicked => {
                                root.verify-saved-connection(connection.id);
                            }
                        }

                        CardSecondaryActionButton {
                            accessible-label: "Edit connection " + connection.name;
                            text: "Edit";
                            clicked => {
                                root.request-connection-edit(connection.id);
                            }
                        }

                        CardSecondaryActionButton {
                            accessible-label: "Delete connection " + connection.name;
                            text: "Delete";
                            clicked => {
                                root.request-connection-delete(connection.id);
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    }
                }
            }
        }
    }
}
