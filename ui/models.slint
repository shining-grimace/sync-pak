export enum BucketDiscovery {
    unchecked,
    loading,
    listed,
    failed,
}

export struct ProviderRow {
    id: string,
    name: string,
    kind: string,
    verification: string,
    verifying: bool,
    connection-summary: string,
}

export struct ConnectionRow {
    id: string,
    name: string,
    detail: string,
    verification: string,
    verifying: bool,
    mode: int,
    local-path: string,
    local-path-source: string,
    provider-name: string,
    remote-location: string,
    archive-retention: string,
    running: bool,
    result-id: string,
    last-run: string,
}

export struct ActivityRow {
    id: string,
    title: string,
    detail: string,
    status: string,
    progress: string,
    current-path: string,
    percent: int,
    running: bool,
    cancelling: bool,
    result: string,
    can-cancel: bool,
    can-remove: bool,
    can-view-result: bool,
}

export struct ArchiveReviewRow {
    path: string,
    included: bool,
}

export struct AppNotification {
    id: int,
    message: string,
    kind: int,
    action: int,
    fading: bool,
    height: length,
    offset: length,
}

export struct MirrorReviewRow {
    path: string,
    action-label: string,
    deleting: bool,
    local-detail: string,
    remote-detail: string,
    local-present: bool,
    remote-present: bool,
    local-changed: bool,
    remote-changed: bool,
    selected: bool,
    can-first: bool,
    can-second: bool,
}

export struct FileVersion {
    path: string,
    size: string,
    message: string,
    preview-text: string,
    preview-image: image,
    has-text: bool,
}
