<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_syncpak" android:contentDescription="Open SyncPak" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="SyncPak" android:textColor="?attr/widgetPrimary" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_connection" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:text="Choose connection ▾" android:textColor="?attr/widgetPrimary" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_disclaimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Only connections with preview turned off are available." android:textColor="?attr/widgetPrimary" android:textSize="12sp" android:maxLines="3" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="?attr/widgetPrimary" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/widget_run" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_gravity="end" android:layout_marginTop="4dp" android:minWidth="76dp" android:minHeight="0dp" android:background="@drawable/widget_button" android:paddingHorizontal="12dp" android:text="Run" android:textColor="@color/widget_button_foreground" android:textSize="14sp" android:textAllCaps="false" />
</LinearLayout>
