import { ScrollView } from "std-widgets.slint";
import { Dimensions } from "../dimensions.slint";
import { ActivityRow } from "../models.slint";
import { CenteredPageColumn } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { InfoCard } from "../components/cards.slint";
import {
    CardPrimaryActionButton,
    CardSecondaryActionButton,
    PrimaryActionButton,
} from "../components/action-buttons.slint";
import { ListItem, ListView } from "../components/list-and-action-layouts.slint";

export component ActivityPage inherits ScrollView {
    in property <[ActivityRow]> activity-rows;
    in property <int> activity-clearable-count;
    callback clear-completed-activity();
    callback show-activity-result(string);
    callback show-activity-progress(string);
    callback request-cancel-activity(string, string);
    callback remove-queued-activity(string);

    vertical-scrollbar-policy: always-on;

    CenteredPageColumn {
        width: parent.width - 12px;
        HeadingLabel {
            text: "Activity";
        }
        DescriptionLabel {
            text: "Queued and completed operations appear here until SyncPak exits.";
        }
        if root.activity-clearable-count > 0 : VerticalLayout {
            spacing: 4px;
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                forward-focus: clear-completed-activity;
                init => {
                    self.focus();
                }
            }
            clear-completed-activity := PrimaryActionButton {
                accessible-label: "Clear " + root.activity-clearable-count + " completed activity entries";
                text: root.activity-clearable-count == 1 ? "Clear Completed Entry" : "Clear Completed Entries";
                clicked => {
                    root.clear-completed-activity();
                }
            }
            DescriptionLabel {
                text: "Removes " + root.activity-clearable-count +
                    (root.activity-clearable-count == 1 ? " completed, failed, or cancelled entry." : " completed, failed, or cancelled entries.");
            }
        }
        if root.activity-rows.length == 0 : InfoCard {
            accessible-role: region;
            accessible-label: "No activity this time";
            min-height: 130px;
            VerticalLayout {
                spacing: Dimensions.card-element-spacing;
                alignment: center;
                SectionHeadingLabel {
                    text: "No activity this time";
                    horizontal-alignment: center;
                }
                DescriptionLabel {
                    text: "Queued and completed operations will appear here until SyncPak exits.";
                    horizontal-alignment: center;
                }
            }
        }
        if root.activity-rows.length > 0 : ListView {
            accessible-label: "Current activity";
            height: 240px;
            vertical-scrollbar-policy: always-on;
            for activity in root.activity-rows : ListItem {
                InfoCard {
                    accessible-role: list-item;
                    accessible-label: activity.title + ". " + activity.status + ". " + activity.detail +
                        (activity.progress != "" ? ". Progress: " + activity.progress : "") +
                        (activity.result != "" ? ". Result: " + activity.result : "");
                    min-height: root.width < Dimensions.narrow-layout-breakpoint ? 166px : 86px;
                    VerticalLayout {
                        spacing: Dimensions.card-element-spacing;
                        VerticalLayout {
                            spacing: Dimensions.card-element-spacing;
                            SectionHeadingLabel {
                                text: activity.title + " · " + activity.status;
                            }
                            DescriptionLabel {
                                text: activity.detail;
                            }
                            if activity.progress != "" : DescriptionLabel {
                                text: "Progress: " + activity.progress;
                            }
                            if activity.result != "" : DescriptionLabel {
                                text: "Result: " + activity.result;
                            }
                        }
                        if (activity.can-cancel || activity.can-remove || activity.can-view-result) && root.width < Dimensions.narrow-layout-breakpoint : VerticalLayout {
                            spacing: Dimensions.card-element-spacing;
                            if activity.can-view-result : CardPrimaryActionButton {
                                accessible-label: "View result for " + activity.title;
                                text: "View Result";
                                clicked => {
                                    root.show-activity-result(activity.id);
                                }
                            }
                            if activity.can-cancel : CardPrimaryActionButton {
                                accessible-label: "View progress for " + activity.title;
                                text: "View Progress";
                                clicked => {
                                    root.show-activity-progress(activity.id);
                                }
                            }
                            if activity.can-cancel : CardSecondaryActionButton {
                                accessible-label: "Cancel " + activity.title;
                                text: "Cancel";
                                clicked => {
                                    root.request-cancel-activity(activity.id, activity.title);
                                }
                            }
                            if activity.can-remove : CardSecondaryActionButton {
                                accessible-label: "Remove " + activity.title;
                                text: "Remove";
                                clicked => {
                                    root.remove-queued-activity(activity.id);
                                }
                            }
                        }
                        if (activity.can-cancel || activity.can-remove || activity.can-view-result) && root.width >= Dimensions.narrow-layout-breakpoint : HorizontalLayout {
                            spacing: Dimensions.card-element-spacing;
                            if activity.can-view-result : CardPrimaryActionButton {
                                accessible-label: "View result for " + activity.title;
                                text: "View Result";
                                clicked => {
                                    root.show-activity-result(activity.id);
                                }
                            }
                            if activity.can-cancel : CardPrimaryActionButton {
                                accessible-label: "View progress for " + activity.title;
                                text: "View Progress";
                                clicked => {
                                    root.show-activity-progress(activity.id);
                                }
                            }
                            if activity.can-cancel : CardSecondaryActionButton {
                                accessible-label: "Cancel " + activity.title;
                                text: "Cancel";
                                clicked => {
                                    root.request-cancel-activity(activity.id, activity.title);
                                }
                            }
                            if activity.can-remove : CardSecondaryActionButton {
                                accessible-label: "Remove " + activity.title;
                                text: "Remove";
                                clicked => {
                                    root.remove-queued-activity(activity.id);
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
