import { Button, VerticalBox } from "std-widgets.slint";
import { Colors } from "../colors.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";

export component ConnectionDiscardConfirmationPage inherits CenteredPageRoot {
    in property <string> connection-name;
    callback cancel(); callback confirm();

    Text { text: "Discard unsaved changes?"; color: Colors.text-primary; font-size: 28px; font-weight: 800; }
    Text { text: "Your changes to this connection have not been saved."; wrap: word-wrap; }
    VerticalBox {
        Button { accessible-label: "Continue editing connection " + root.connection-name; text: "Continue editing"; clicked => { root.cancel(); } }
        Button { accessible-label: "Discard changes to connection " + root.connection-name; text: "Discard " + root.connection-name + " changes"; primary: true; clicked => { root.confirm(); } }
    }
}
