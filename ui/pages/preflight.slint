import { MeasuredVerticalRegion } from "../components/measured-vertical-region.slint";
import { CheckBox } from "std-widgets.slint";
import { Dimensions } from "../dimensions.slint";
import { Colors } from "../colors.slint";
import { PreflightChanges } from "../components/preflight-changes.slint";
import { PreflightSummary } from "../components/preflight-summary.slint";
import { ReconciliationReview } from "../components/reconciliation-review.slint";
import { MirrorReviewRow, PreflightRow } from "../models.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { PageHeader } from "../components/page-header.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { ErrorHeadingLabel } from "../components/error-heading-label.slint";
import { SuccessLabel } from "../components/success-label.slint";
import { DangerCard, InfoCard } from "../components/cards.slint";
import { ExpandedPrimaryActionButton, ExpandedSecondaryActionButton } from "../components/action-buttons.slint";
import { FooterActionRow, ListLoadingIndicator } from "../components/list-and-action-layouts.slint";

export component PreflightPage inherits CenteredPageRoot {
    in property <[MirrorReviewRow]> isolated;
    in property <[MirrorReviewRow]> conflicts;
    in property <[MirrorReviewRow]> synced;
    in property <string> selection-error;
    callback choose-file(string, int, int);
    in property <string> connection-name;
    in property <string> connection-mode;
    in property <string> local-endpoint;
    in property <string> remote-endpoint;
    in property <int> direction;
    in property <bool> loading;
    in property <bool> failed;
    in property <string> failure-message;
    in property <string> additions;
    in property <string> overwrites;
    in property <string> deletions;
    in property <string> skipped;
    in property <string> unchanged;
    in property <int> planned-file-changes;
    in property <bool> has-planned-actions;
    in property <string> start-action;
    in property <bool> requires-mirror-confirmation;
    in-out property <bool> mirror-confirmed;
    in property <int> item-filter;
    in property <[PreflightRow]> items;
    in property <[PreflightRow]> visible-items;
    callback start-operation();
    callback set-item-filter(int);
    callback return-to-direction();
    callback begin-preflight();
    fill-height: true;

    PageHeader {
        title: root.failed ? "This Operation Cannot Start" : (root.loading ? "Checking Before Anything Changes" : (root.connection-mode == "Mirror" ? "Review Mirror Changes" : "Ready to Start"));
        back-label: "Back to direction selection for " + root.connection-name;
        focus-back: root.loading || root.failed || root.items.length == 0;
        back => {
            root.return-to-direction();
        }
    }

    DescriptionLabel {
        text: "Reviewing " + root.connection-name + " · " + root.connection-mode + " · " + (root.direction == 0 ? "Upload" : (root.direction == 1 ? "Download" : "Both ways"));
    }

    InfoCard {
        accessible-role: region;
        accessible-label: root.direction == 2 ? "Comparing both sides: " + root.local-endpoint + " and " + root.remote-endpoint : "Comparing source " + (root.direction == 0 ? root.local-endpoint : root.remote-endpoint) + " with destination " + (root.direction == 0 ? root.remote-endpoint : root.local-endpoint);
        baseline-height: 78px;
            if root.direction != 2: DescriptionLabel {
                text: "Source: " + (root.direction == 0 ? root.local-endpoint : root.remote-endpoint);
            }
            if root.direction != 2: DescriptionLabel {
                text: "Destination: " + (root.direction == 0 ? root.remote-endpoint : root.local-endpoint);
            }
            if root.direction == 2: DescriptionLabel {
                text: "This device: " + root.local-endpoint;
            }
            if root.direction == 2: DescriptionLabel {
                text: "Cloud storage: " + root.remote-endpoint;
            }
    }

    if root.loading: SectionHeadingLabel {
        accessible-live-region: polite;
        text: "Listing files…";
    }
    DescriptionLabel {
        text: "No files are changed during this check.";
    }

    if root.loading: ListLoadingIndicator {
        label: "Listing files";
    }
    if root.failed: DangerCard {
        accessible-role: region;
        accessible-label: "Preflight could not start";
        baseline-height: 92px;
        ErrorHeadingLabel {
            text: "Resolve this issue, then run the connection again. No files were changed.";
        }

        ErrorLabel {
            text: root.failure-message;
        }
    }
    if !root.loading && !root.failed: Rectangle {
        min-height: review-layout.min-height;
        preferred-height: review-layout.preferred-height;
        max-height: review-layout.max-height;
        vertical-stretch: 1;
        review-layout := VerticalLayout {
            spacing: Dimensions.section-gap;
            PreflightSummary {
                additions: root.additions;
                overwrites: root.overwrites;
                deletions: root.deletions;
                skipped: root.skipped;
                unchanged: root.unchanged;
                destructive: root.requires-mirror-confirmation;
            }
            if !root.has-planned-actions && root.selection-error == "": SuccessLabel {
                text: "No actions are selected for this run.";
            }
            if root.connection-mode == "Archive": PreflightChanges {
                items: root.items;
                visible-items: root.visible-items;
                item-filter: root.item-filter;
                planned-file-changes: root.planned-file-changes;
                set-item-filter(filter) => {
                    root.set-item-filter(filter);
                }
            }
            if root.connection-mode == "Mirror": DescriptionLabel {
                text: "Unselected files will be left unchanged. Actions are limited by the selected directions; bulk actions affect eligible files only.";
            }
            if root.connection-mode != "Archive": ReconciliationReview {
                isolated: root.isolated;
                conflicts: root.conflicts;
                synced: root.synced;
                interactive: true;
                destructive: root.connection-mode == "Mirror";
                choose-file(path, section, action) => {
                    root.choose-file(path, section, action);
                }
            }
            if root.selection-error != "": ErrorLabel {
                text: root.selection-error;
            }
            if root.requires-mirror-confirmation: CheckBox {
                accessible-label: "Acknowledge the listed overwrites and deletions";
                text: "I understand that the selected files will be overwritten or deleted.";
                checked <=> root.mirror-confirmed;
            }
            if root.requires-mirror-confirmation && root.mirror-confirmed: SuccessLabel {
                accessible-live-region: polite;
                text: "Destructive mirror changes acknowledged.";
            }
            if root.requires-mirror-confirmation && !root.mirror-confirmed: ErrorLabel {
                accessible-live-region: polite;
                text: "Acknowledge the listed changes before this mirror can start.";
            }
        }
    }
    if !root.loading || root.failed: MeasuredVerticalRegion {
        spacing: Dimensions.element-gap;
        FooterActionRow {
            if root.failed: ExpandedPrimaryActionButton {
                accessible-label: "Try the preflight check again";
                text: "Try Again";
                clicked => {
                    root.begin-preflight();
                }
            }
            if !root.loading && !root.failed: ExpandedSecondaryActionButton {
                accessible-label: "Refresh the read-only preflight review";
                text: "Refresh Review";
                clicked => {
                    root.begin-preflight();
                }
            }
            if !root.loading && !root.failed: ExpandedPrimaryActionButton {
                accessible-label: !root.has-planned-actions ? "Accept review without transferring files" : (root.requires-mirror-confirmation && !root.mirror-confirmed ? root.start-action + " is unavailable until destructive changes are acknowledged" : root.start-action);
                text: root.start-action;
                enabled: root.selection-error == "" && !root.loading && !root.failed && (!root.requires-mirror-confirmation || root.mirror-confirmed);
                emphasized: root.has-planned-actions;
                fill-color: root.has-planned-actions ? Colors.primary-accent : Colors.background-trim;
                label-color: root.has-planned-actions ? Colors.background-trim : Colors.primary-accent;
                clicked => {
                    root.start-operation();
                }
            }
        }

        if !root.loading && !root.failed && root.requires-mirror-confirmation && !root.mirror-confirmed: ErrorLabel {
            text: "Acknowledge the destructive changes above before starting.";
        }
    }
}
