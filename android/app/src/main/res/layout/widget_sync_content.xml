<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="8dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_widget_syncpak" android:contentDescription="Open SyncPak" />
        <TextView android:id="@+id/widget_app_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginHorizontal="6dp" android:gravity="center_vertical" android:text="SyncPak" android:textColor="@color/widget_button_foreground" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <Button android:id="@+id/widget_run" android:layout_width="wrap_content" android:layout_height="28dp" android:minWidth="56dp" android:minHeight="0dp" android:background="@drawable/widget_button" android:paddingHorizontal="8dp" android:text="Run" android:textColor="@color/widget_button_foreground" android:textSize="12sp" android:textAllCaps="false" />
    </LinearLayout>
    <TextView android:id="@+id/widget_connection" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:text="Choose connection ▾" android:textColor="@color/widget_button_foreground" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/widget_disclaimer" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Only connections with preview turned off are available." android:textColor="@color/widget_button_foreground" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:textColor="?attr/widgetPrimary" android:textSize="10sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    </FrameLayout>
</LinearLayout>
