<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape>
        <solid android:color="?attr/widgetBackground" />
        <stroke android:width="1dp" android:color="?attr/widgetDisabledPrimary" />
        <corners android:radius="12dp" />
    </shape></item>
    <item><shape>
        <solid android:color="?attr/widgetBackground" />
        <stroke android:width="1dp" android:color="?attr/widgetPrimary" />
        <corners android:radius="12dp" />
    </shape></item>
</selector>
