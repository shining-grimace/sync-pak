import {
    CheckBox,
} from "std-widgets.slint";
import { Dimensions } from "../dimensions.slint";
import { PreflightRow } from "../models.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { ErrorHeadingLabel } from "../components/error-heading-label.slint";
import { SuccessLabel } from "../components/success-label.slint";
import { DangerCard, InfoCard } from "../components/cards.slint";
import { FilterButton, PrimaryActionButton, SecondaryActionButton } from "../components/action-buttons.slint";
import { ListItem, ListView } from "../components/list-and-action-layouts.slint";

component MeasuredVerticalRegion inherits Rectangle {
    in property <length> spacing;

    min-height: region-layout.min-height;
    preferred-height: region-layout.preferred-height;
    max-height: region-layout.max-height;
    vertical-stretch: 0;

    region-layout := VerticalLayout {
        spacing: root.spacing;
        @children
    }
}

export component PreflightPage inherits CenteredPageRoot {
    in property <string> connection-name;
    in property <string> connection-mode;
    in property <string> local-endpoint;
    in property <string> remote-endpoint;
    in property <int> direction;
    in property <bool> loading;
    in property <bool> failed;
    in property <string> failure-message;
    in property <string> additions;
    in property <string> overwrites;
    in property <string> deletions;
    in property <string> skipped;
    in property <string> start-action;
    in property <bool> requires-mirror-confirmation;
    in-out property <bool> mirror-confirmed;
    in property <int> item-filter;
    in property <[PreflightRow]> items;
    in property <[PreflightRow]> visible-items;
    callback start-operation();
    callback set-item-filter(int);
    callback return-to-direction();
    callback begin-preflight();
    fill-height: true;

    HeadingLabel {
        text: root.failed ? "This Operation Cannot Start" : (root.loading ? "Checking Before Anything Changes" : (root.requires-mirror-confirmation ? "Review Mirror Changes" : "Ready to Start"));
        wrap: word-wrap;
    }

    DescriptionLabel {
        text: "Reviewing " + root.connection-name + " · " + root.connection-mode + " · " + (root.direction == 0 ? "Upload" : (root.direction == 1 ? "Download" : "Both ways"));
    }

    InfoCard {
        accessible-role: region;
        accessible-label: root.direction == 2 ? "Comparing both sides: " + root.local-endpoint + " and " + root.remote-endpoint : "Comparing source " + (root.direction == 0 ? root.local-endpoint : root.remote-endpoint) + " with destination " + (root.direction == 0 ? root.remote-endpoint : root.local-endpoint);
        baseline-height: 78px;
            if root.direction != 2: DescriptionLabel {
                text: "Source: " + (root.direction == 0 ? root.local-endpoint : root.remote-endpoint);
            }
            if root.direction != 2: DescriptionLabel {
                text: "Destination: " + (root.direction == 0 ? root.remote-endpoint : root.local-endpoint);
            }
            if root.direction == 2: DescriptionLabel {
                text: "This device: " + root.local-endpoint;
            }
            if root.direction == 2: DescriptionLabel {
                text: "Cloud storage: " + root.remote-endpoint;
            }
    }

    if root.loading: SectionHeadingLabel {
        accessible-live-region: polite;
        text: "Listing files…";
    }
    DescriptionLabel {
        text: "No files are changed during this check.";
    }

    if root.loading: InfoCard {
        baseline-height: 110px;
        DescriptionLabel {
            text: "Preflight will compare the endpoints above, then show additions, overwrites, deletions, and skipped files before anything starts.";
        }
    }
    if root.failed: DangerCard {
        accessible-role: region;
        accessible-label: "Preflight could not start";
        baseline-height: 92px;
        ErrorHeadingLabel {
            text: "Resolve this issue, then run the connection again. No files were changed.";
        }

        ErrorLabel {
            text: root.failure-message;
        }
    }
    if !root.loading && !root.failed: Rectangle {
        min-height: review-layout.min-height;
        preferred-height: review-layout.preferred-height;
        max-height: review-layout.max-height;
        vertical-stretch: 1;
        review-layout := VerticalLayout {
            spacing: Dimensions.section-gap;
            MeasuredVerticalRegion {
                accessible-role: region;
                accessible-label: "Plan summary: " + root.additions + ", " + root.overwrites + ", " + root.deletions + ", " + root.skipped;
                spacing: Dimensions.element-gap;
                if root.width < Dimensions.medium-layout-breakpoint: VerticalLayout {
                    spacing: Dimensions.element-gap;
                    DescriptionLabel {
                        text: root.additions;
                    }

                    DescriptionLabel {
                        text: root.overwrites;
                    }

                    DescriptionLabel {
                        text: root.deletions;
                    }

                    DescriptionLabel {
                        text: root.skipped;
                    }
                }
                if root.width >= Dimensions.medium-layout-breakpoint: HorizontalLayout {
                    spacing: Dimensions.element-gap;
                    DescriptionLabel {
                        text: root.additions;
                    }

                    DescriptionLabel {
                        text: root.overwrites;
                    }
                }
                if root.width >= Dimensions.medium-layout-breakpoint: HorizontalLayout {
                    spacing: Dimensions.element-gap;
                    DescriptionLabel {
                        text: root.deletions;
                    }

                    DescriptionLabel {
                        text: root.skipped;
                    }
                }
            }

            if root.requires-mirror-confirmation: DangerCard {
                accessible-role: region;
                accessible-label: "Destructive mirror changes";
                baseline-height: 86px;
                ErrorHeadingLabel {
                    text: "Destructive mirror changes";
                }

                ErrorLabel {
                    accessible-live-region: assertive;
                    text: "SyncPak will attempt to make the destination match the source. Review every overwrite and deletion before continuing.";
                }

                ErrorLabel {
                    text: root.overwrites + " · " + root.deletions;
                }
            }
            if root.items.length == 0: SuccessLabel {
                text: "No changes are needed. The reviewed local folder and cloud storage already match for this direction.";
            }
            if root.items.length > 0: DescriptionLabel {
                accessible-live-region: polite;
                text: root.item-filter == 0 ? "Reviewing " + root.items.length + " planned file changes." : "Showing " + root.visible-items.length + " matching planned changes.";
            }
            MeasuredVerticalRegion {
                if root.items.length > 0: MeasuredVerticalRegion {
                    vertical-stretch: 0;
                    accessible-role: region;
                    accessible-label: "Filter planned file changes";
                    spacing: Dimensions.element-gap;
                    SectionHeadingLabel {
                        text: "Show planned changes";
                    }

                    HorizontalLayout {
                        spacing: Dimensions.element-gap;
                        preflight-filter-all := FilterButton {
                            accessible-label: root.item-filter == 0 ? "All planned changes, selected" : "Show all planned changes";
                            text: "All";
                            selected: root.item-filter == 0;
                            clicked => {
                                root.set-item-filter(0);
                            }
                        }

                        FilterButton {
                            accessible-label: root.item-filter == 1 ? "New files, selected" : "Show new files";
                            text: "New";
                            selected: root.item-filter == 1;
                            clicked => {
                                root.set-item-filter(1);
                            }
                        }

                        FilterButton {
                            accessible-label: root.item-filter == 2 ? "Overwrites, selected" : "Show overwrites";
                            text: "Overwrites";
                            selected: root.item-filter == 2;
                            clicked => {
                                root.set-item-filter(2);
                            }
                        }
                        FilterButton {
                            accessible-label: root.item-filter == 3 ? "Deletions, selected" : "Show deletions";
                            text: "Deletions";
                            selected: root.item-filter == 3;
                            clicked => {
                                root.set-item-filter(3);
                            }
                        }

                        FilterButton {
                            accessible-label: root.item-filter == 4 ? "Warnings, selected" : "Show warnings";
                            text: "Warnings";
                            selected: root.item-filter == 4;
                            clicked => {
                                root.set-item-filter(4);
                            }
                        }
                    }

                    FocusScope {
                        width: 0px;
                        height: 0px;
                        focus-on-click: false;
                        focus-on-tab-navigation: false;
                        forward-focus: preflight-filter-all;
                        init => {
                            self.focus();
                        }
                    }
                }
            }
            if root.visible-items.length > 0: ListView {
                accessible-label: root.item-filter == 0 ? "All planned file changes" : (root.item-filter == 1 ? "Planned new files" : (root.item-filter == 2 ? "Planned overwrites" : (root.item-filter == 3 ? "Planned deletions" : "Planned warnings")));
                vertical-stretch: 1;
                vertical-scrollbar-policy: always-on;
                for item in root.visible-items: ListItem {
                    width: parent.width;
                    accessible-role: list-item;
                    accessible-label: item.status + ": " + item.path + ". " + item.detail;
                    spacing: Dimensions.element-gap;
                    if root.width < Dimensions.narrow-layout-breakpoint: SectionHeadingLabel {
                        text: item.status;
                    }
                    if root.width >= Dimensions.narrow-layout-breakpoint: HorizontalLayout {
                        spacing: Dimensions.element-gap;
                        DescriptionLabel {
                            text: item.status;
                            width: 110px;
                        }

                        DescriptionLabel {
                            text: item.path;
                            horizontal-stretch: 1;
                        }
                    }
                    if root.width < Dimensions.narrow-layout-breakpoint: DescriptionLabel {
                        text: item.path;
                    }
                    VerticalLayout {
                        spacing: Dimensions.element-gap;
                        DescriptionLabel {
                            text: item.detail;
                        }
                    }
                }
            }
            if root.items.length > 0 && root.visible-items.length == 0: InfoCard {
                accessible-role: region;
                accessible-label: "No entries in the selected planned change category";
                baseline-height: 74px;
                DescriptionLabel {
                    text: root.item-filter == 1 ? "No new files are planned." : (root.item-filter == 2 ? "No overwrites are planned." : (root.item-filter == 3 ? "No deletions are planned." : "No warnings are listed in this review."));
                }
            }
            if root.requires-mirror-confirmation: CheckBox {
                accessible-label: "Acknowledge the listed overwrites and deletions";
                text: "I understand that the listed destination files will be overwritten or deleted.";
                checked <=> root.mirror-confirmed;
            }
            if root.requires-mirror-confirmation && root.mirror-confirmed: SuccessLabel {
                accessible-live-region: polite;
                text: "Destructive mirror changes acknowledged.";
            }
            if root.requires-mirror-confirmation && !root.mirror-confirmed: ErrorLabel {
                accessible-live-region: polite;
                text: "Acknowledge the listed changes before this mirror can start.";
            }
            PrimaryActionButton {
                accessible-label: root.requires-mirror-confirmation && !root.mirror-confirmed ? root.start-action + " is unavailable until destructive changes are acknowledged" : root.start-action;
                text: root.start-action;
                enabled: !root.loading && !root.failed && (!root.requires-mirror-confirmation || root.mirror-confirmed);
                clicked => {
                    root.start-operation();
                }
            }

            if root.requires-mirror-confirmation && !root.mirror-confirmed: ErrorLabel {
                text: "Acknowledge the destructive changes above before starting.";
            }
        }
    }
    MeasuredVerticalRegion {
        spacing: Dimensions.element-gap;
        if root.loading || root.failed || root.items.length == 0: FocusScope {
            width: 0px;
            height: 0px;
            focus-on-click: false;
            focus-on-tab-navigation: false;
            forward-focus: preflight-back;
            init => {
                self.focus();
            }
        }
        preflight-back := SecondaryActionButton {
            accessible-label: "Return to direction selection for " + root.connection-name;
            text: "Back";
            clicked => {
                root.return-to-direction();
            }
        }

        if root.failed: PrimaryActionButton {
            accessible-label: "Try the preflight check again";
            text: "Try Again";
            clicked => {
                root.begin-preflight();
            }
        }
        if !root.loading && !root.failed: SecondaryActionButton {
            accessible-label: "Refresh the read-only preflight review";
            text: "Refresh Review";
            clicked => {
                root.begin-preflight();
            }
        }
    }
}
