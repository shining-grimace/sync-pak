import { Button, HorizontalBox, ListView, ScrollView, VerticalBox } from "std-widgets.slint";
import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";
import { ActivityRow } from "../models.slint";
import { CenteredPageColumn } from "../components/page-layouts.slint";

export component ActivityPage inherits ScrollView {
    in property <[ActivityRow]> activity-rows; in property <int> activity-clearable-count;
    callback clear-completed-activity(); callback show-activity-result(string); callback show-activity-progress(string); callback request-cancel-activity(string, string); callback remove-queued-activity(string);
    vertical-scrollbar-policy: always-on;
            CenteredPageColumn { width: parent.width - 12px;
            Text { text: "Activity"; color: Colors.text-primary; font-size: 32px; font-weight: 800; }
            Text { text: "Queued and completed operations appear here until SyncPak exits."; color: Colors.text-secondary; wrap: word-wrap; }
            if root.activity-clearable-count > 0 : VerticalBox {
                spacing: 4px;
                FocusScope { width: 0px; height: 0px; focus-on-click: false; focus-on-tab-navigation: false; forward-focus: clear-completed-activity; init => { self.focus(); } }
                clear-completed-activity := Button { accessible-label: "Clear " + root.activity-clearable-count + " completed activity entries"; text: root.activity-clearable-count == 1 ? "Clear completed entry" : "Clear completed entries"; clicked => { root.clear-completed-activity(); } }
                Text { text: "Removes " + root.activity-clearable-count + (root.activity-clearable-count == 1 ? " completed, failed, or cancelled entry." : " completed, failed, or cancelled entries."); color: Colors.text-secondary; wrap: word-wrap; }
            }
            if root.activity-rows.length == 0 : Rectangle {
                accessible-role: region;
                accessible-label: "No activity this time";
                background: Colors.surface; border-color: Colors.border; border-width: 1px; border-radius: 8px; min-height: 130px;
                VerticalBox { padding: 20px; spacing: 8px; alignment: center;
                    Text { text: "No activity this time"; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                    Text { text: "Queued and completed operations will appear here until SyncPak exits."; color: Colors.text-secondary; wrap: word-wrap; horizontal-alignment: center; }
                }
            }
            if root.activity-rows.length > 0 : ListView {
                accessible-label: "Current activity";
                height: 240px;
                vertical-scrollbar-policy: always-on;
                for activity in root.activity-rows : Rectangle {
                    accessible-role: list-item;
                    accessible-label: activity.title + ". " + activity.status + ". " + activity.detail + (activity.progress != "" ? ". Progress: " + activity.progress : "") + (activity.result != "" ? ". Result: " + activity.result : "");
                    background: Colors.surface; border-color: Colors.border; border-width: 1px; border-radius: 8px; min-height: root.width < Dimensions.narrow-layout-breakpoint ? 166px : 86px;
                    VerticalBox { padding: 12px; spacing: 8px;
                        VerticalBox { spacing: 2px;
                            Text { text: activity.title + " · " + activity.status; font-weight: 700; wrap: word-wrap; }
                            Text { text: activity.detail; color: Colors.text-secondary; wrap: word-wrap; }
                            if activity.progress != "" : Text { text: "Progress: " + activity.progress; color: Colors.text-secondary; wrap: word-wrap; }
                            if activity.result != "" : Text { text: "Result: " + activity.result; color: Colors.text-secondary; wrap: word-wrap; }
                        }
                        if (activity.can-cancel || activity.can-remove || activity.can-view-result) && root.width < Dimensions.narrow-layout-breakpoint : VerticalBox {
                            spacing: 8px;
                            if activity.can-view-result : Button { accessible-label: "View result for " + activity.title; text: "View result"; clicked => { root.show-activity-result(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "View progress for " + activity.title; text: "View progress"; clicked => { root.show-activity-progress(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "Cancel " + activity.title; text: "Cancel"; clicked => { root.request-cancel-activity(activity.id, activity.title); } }
                            if activity.can-remove : Button { accessible-label: "Remove " + activity.title; text: "Remove"; clicked => { root.remove-queued-activity(activity.id); } }
                        }
                        if (activity.can-cancel || activity.can-remove || activity.can-view-result) && root.width >= Dimensions.narrow-layout-breakpoint : HorizontalBox {
                            spacing: 8px;
                            if activity.can-view-result : Button { accessible-label: "View result for " + activity.title; text: "View result"; clicked => { root.show-activity-result(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "View progress for " + activity.title; text: "View progress"; clicked => { root.show-activity-progress(activity.id); } }
                            if activity.can-cancel : Button { accessible-label: "Cancel " + activity.title; text: "Cancel"; clicked => { root.request-cancel-activity(activity.id, activity.title); } }
                            if activity.can-remove : Button { accessible-label: "Remove " + activity.title; text: "Remove"; clicked => { root.remove-queued-activity(activity.id); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            }
}

