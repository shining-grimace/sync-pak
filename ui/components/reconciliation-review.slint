import { ArchiveReviewRow, MirrorReviewRow } from "../models.slint";
import { Dimensions } from "../dimensions.slint";
import { ScrollArea } from "scroll-area.slint";
import { ReconciliationSection } from "reconciliation-section.slint";

import { ArchiveIncludedSection } from "archive-included-section.slint";

export component ReconciliationReview inherits ScrollArea {
    in property <bool> archive;
    in property <[ArchiveReviewRow]> archive-rows;
    in property <bool> archive-all-included;
    callback set-archive-included(string, bool);
    in property <[MirrorReviewRow]> isolated;
    in property <[MirrorReviewRow]> conflicts;
    in property <[MirrorReviewRow]> synced;
    in property <bool> interactive;
    in property <bool> destructive: true;
    callback compare-file(string);
    callback choose-file(string, int, int);
    vertical-stretch: 1;
    vertical-scrollbar-policy: always-on;
    VerticalLayout {
        spacing: Dimensions.section-gap;
        if root.archive: ArchiveIncludedSection {
            rows: root.archive-rows;
            all-included: root.archive-all-included;
            set-included(path, included) => {
                root.set-archive-included(path, included);
            }
        }
        if !root.archive: ReconciliationSection {
            title: "Isolated Files";
            section: 0;
            rows: root.isolated;
            interactive: root.interactive;
            destructive: root.destructive;
            compare-file(path) => {
                root.compare-file(path);
            }
            choose-file(path, section, action) => {
                root.choose-file(path, section, action);
            }
        }
        if !root.archive: ReconciliationSection {
            title: "Conflicting Versions";
            section: 1;
            rows: root.conflicts;
            interactive: root.interactive;
            destructive: root.destructive;
            compare-file(path) => {
                root.compare-file(path);
            }
            choose-file(path, section, action) => {
                root.choose-file(path, section, action);
            }
        }
        if !root.archive: ReconciliationSection {
            title: "In Sync";
            section: 2;
            rows: root.synced;
            interactive: false;
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}
