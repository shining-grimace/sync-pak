import { Button } from "std-widgets.slint";
import { Dimensions } from "../dimensions.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { ErrorHeadingLabel } from "../components/error-heading-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { DangerCard, InfoCard } from "../components/cards.slint";

export component WelcomePage inherits CenteredPageRoot {
    in property <bool> configuration-unavailable;
    callback retry-configuration();
    callback show-add-provider();
    callback show-privacy();

    VerticalLayout {
        spacing: 14px;
        alignment: center;
        HeadingLabel {
            text: "Your files, your cloud.";
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        DescriptionLabel {
            text: "SyncPak copies folders directly between this device and cloud providers you choose. SyncPak does not operate an intermediary file service.";
            max-width: Dimensions.welcome-content-max-width;
        }

        Rectangle {
            height: 16px;
            background: transparent;
        }

        InfoCard {
            accessible-role: region;
            accessible-label: "Protected credentials";
            max-width: Dimensions.welcome-content-max-width;
            min-height: 92px;
            DescriptionLabel {
                text: "Your provider credentials are protected using this device's secure storage and are sent only to that provider.";
            }
        }

        InfoCard {
            accessible-role: region;
            accessible-label: "Choose how each connection behaves";
            max-width: Dimensions.welcome-content-max-width;
            min-height: 106px;
            SectionHeadingLabel {
                text: "Choose how each connection behaves";
            }

            DescriptionLabel {
                text: "Add-only — Copy new files without overwriting or deleting anything.";
            }

            DescriptionLabel {
                text: "Mirror — Attempt to make a destination match its source after previewing destructive changes. Any issues are listed when the operation finishes.";
            }

            DescriptionLabel {
                text: "Archive — Create timestamped ZIP archives and keep the number you choose.";
            }
        }

        Rectangle {
            height: 16px;
            background: transparent;
        }

        if root.configuration-unavailable: DangerCard {
            accessible-role: region;
            accessible-label: "Configuration storage unavailable";
            max-width: Dimensions.welcome-content-max-width;
            min-height: 122px;
            ErrorHeadingLabel {
                text: "Configuration storage is unavailable";
            }

            ErrorLabel {
                text: "SyncPak cannot save providers or connections until its configuration storage is available.";
            }

            HorizontalLayout {
                alignment: center;
                FocusScope {
                    width: 0px;
                    height: 0px;
                    focus-on-click: false;
                    focus-on-tab-navigation: false;
                    forward-focus: retry-configuration;
                    init => {
                        self.focus();
                    }
                }

                retry-configuration := Button {
                    accessible-label: "Retry opening configuration storage";
                    text: "Retry";
                    primary: true;
                    clicked => {
                        root.retry-configuration();
                    }
                }
            }
        }
        if !root.configuration-unavailable: HorizontalLayout {
            alignment: center;
            FocusScope {
                width: 0px;
                height: 0px;
                focus-on-click: false;
                focus-on-tab-navigation: false;
                forward-focus: welcome-add-provider;
                init => {
                    self.focus();
                }
            }

            welcome-add-provider := Button {
                accessible-label: "Add your first provider";
                text: "Add your first provider";
                primary: true;
                preferred-width: Dimensions.welcome-action-max-width;
                max-width: Dimensions.welcome-action-max-width;
                clicked => {
                    root.show-add-provider();
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Button {
                accessible-label: "Read how SyncPak protects your privacy";
                text: "Read how SyncPak protects your privacy";
                preferred-width: Dimensions.welcome-action-max-width;
                max-width: Dimensions.welcome-action-max-width;
                clicked => {
                    root.show-privacy();
                }
            }
        }
    }
}
