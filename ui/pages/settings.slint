import { FooterActionRow } from "../components/list-and-action-layouts.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { Dimensions } from "../dimensions.slint";
import { ComboBox } from "../components/form-controls.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { SectionHeadingLabel } from "../components/section-heading-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import {
    ExpandedPrimaryActionButton,
    ExpandedSecondaryActionButton,
} from "../components/action-buttons.slint";
import { SettingsAboutSection } from "settings-about.slint";

import { SettingsState } from "../settings-state.slint";
import { ConnectionListsSection } from "settings-lists.slint";
import { SettingsSupportSection } from "settings-support.slint";

export component SettingsPage inherits CenteredPageRoot {
    in property <[string]> credential-provider-names;
    in-out property <int> credential-provider-index;
    in property <string> credential-provider-summary;
    in property <bool> credential-discovery-busy;
    in property <bool> credential-storage-busy;
    callback select-credential-provider(int);
    callback refresh-credential-providers();
    in property <bool> is-android;
    in property <int> support-phase;
    in property <string> support-price;
    in property <string> support-message;
    callback buy-support();
    callback refresh-support();
    in property <string> settings-directory;
    in property <string> app-version;
    in property <bool> configuration-unavailable;
    in-out property <int> appearance-preference;
    callback open-settings-directory();
    callback apply-appearance-preference();
    callback change-appearance-preference(int);
    callback show-diagnostics();
    callback show-privacy();

    HeadingLabel {
        text: "Settings";
    }
    if SettingsState.mode == 0: VerticalLayout {
        spacing: Dimensions.section-gap;
        SettingsAboutSection {
            is-android: root.is-android;
            app-version: root.app-version;
            show-diagnostics => {
                root.show-diagnostics();
            }
        }

        if root.is-android: SettingsSupportSection {
            phase: root.support-phase;
            price: root.support-price;
            message: root.support-message;
            buy => {
                root.buy-support();
            }
            refresh => {
                root.refresh-support();
            }
        }

        ConnectionListsSection {
            enabled: !root.configuration-unavailable;
        }

        VerticalLayout {
            spacing: Dimensions.element-gap;
            SectionHeadingLabel {
                text: "Default store for new providers";
            }
            DescriptionLabel {
                text: root.credential-provider-summary;
            }
            DescriptionLabel {
                text: "Choose where new cloud providers' credentials are stored on this device. Existing providers keep using their original credential store. This preference is not included in exported connection lists.";
            }
            ComboBox {
                accessible-label: "Default store for new providers";
                model: root.credential-provider-names;
                current-index <=> root.credential-provider-index;
                enabled: !root.configuration-unavailable && !root.credential-discovery-busy && !root.credential-storage-busy && root.credential-provider-names.length > 0;
                selected => {
                    root.select-credential-provider(self.current-index);
                }
            }
            ExpandedSecondaryActionButton {
                text: root.credential-discovery-busy ? "Checking…" : "Refresh Credential Providers";
                enabled: !root.configuration-unavailable && !root.credential-discovery-busy && !root.credential-storage-busy;
                clicked => {
                    root.refresh-credential-providers();
                }
            }
        }

        VerticalLayout {
            accessible-role: region;
            accessible-label: "Appearance";
            spacing: Dimensions.element-gap;
            SectionHeadingLabel {
                text: "Appearance";
            }

            DescriptionLabel {
                text: "Choose whether SyncPak follows your system appearance or always uses a light or dark theme.";
            }

            ComboBox {
                accessible-label: "Appearance";
                model: ["System default", "Light", "Dark"];
                current-index <=> root.appearance-preference;
                enabled: !root.configuration-unavailable;
                selected => {
                    root.apply-appearance-preference();
                    root.change-appearance-preference(self.current-index);
                }
            }
        }

        if root.settings-directory != "": VerticalLayout {
            accessible-role: region;
            accessible-label: "Local Data";
            spacing: Dimensions.element-gap;

            SectionHeadingLabel {
                text: "Local Data";
            }

            DescriptionLabel {
                text: "Settings are being stored at:";
            }

            DescriptionLabel {
                text: root.settings-directory;
            }
        }

        FooterActionRow {
            if root.settings-directory != "": ExpandedPrimaryActionButton {
                accessible-label: "Open settings directory in your file browser";
                text: "Open Settings Directory";
                clicked => {
                    root.open-settings-directory();
                }
            }

            ExpandedSecondaryActionButton {
                text: "Privacy";
                clicked => {
                    root.show-privacy();
                }
            }
        }
    }
}
