import { Button, ListView } from "std-widgets.slint";
import { CenteredPageRoot } from "../components/page-layouts.slint";
import { HeadingLabel } from "../components/heading-label.slint";
import { ErrorHeadingLabel } from "../components/error-heading-label.slint";
import { ErrorLabel } from "../components/error-label.slint";
import { DescriptionLabel } from "../components/description-label.slint";
import { DangerCard } from "../components/cards.slint";
import { Dimensions } from "../dimensions.slint";

export component ProviderDeletePage inherits CenteredPageRoot {
    in property <string> provider-name;
    in property <int> connection-count;
    in property <[string]> connections;
    callback cancel();
    callback confirm();
    HeadingLabel {
        text: "Delete " + root.provider-name + "?";
    }

    DangerCard {
        accessible-role: region;
        accessible-label: "Provider deletion consequences";
        min-height: 108px;
        VerticalLayout {
            spacing: Dimensions.card-element-spacing;
            ErrorHeadingLabel {
                text: "What will be deleted";
            }

            ErrorLabel {
                text: "The protected credentials and " + root.connection-count + (root.connection-count == 1 ? " dependent connection will be removed from SyncPak." : " dependent connections will be removed from SyncPak.");
            }

            ErrorLabel {
                text: "Local folders and cloud files are not deleted.";
            }
        }
    }

    if root.connections.length > 0: VerticalLayout {
        spacing: 3px;
        ErrorHeadingLabel {
            text: "Connections that will be deleted";
        }

        ListView {
            accessible-label: "Connections that will be deleted";
            height: 180px;
            vertical-scrollbar-policy: always-on;
            for connection-name in root.connections: DescriptionLabel {
                accessible-role: list-item;
                accessible-label: connection-name;
                text: "• " + connection-name;
            }
        }
    }
    VerticalLayout {
        Button {
            accessible-label: "Keep provider " + root.provider-name;
            text: "Cancel";
            clicked => {
                root.cancel();
            }
        }

        Button {
            accessible-label: "Delete provider " + root.provider-name;
            text: "Delete " + root.provider-name + " and " + root.connection-count + (root.connection-count == 1 ? " connection" : " connections");
            primary: true;
            clicked => {
                root.confirm();
            }
        }
    }
}

export component ConnectionDeletePage inherits CenteredPageRoot {
    in property <string> connection-name;
    callback cancel();
    callback confirm();
    HeadingLabel {
        text: "Delete " + root.connection-name + "?";
        wrap: word-wrap;
    }

    DangerCard {
        accessible-role: region;
        accessible-label: "Connection deletion consequences";
        min-height: 94px;
        VerticalLayout {
            spacing: Dimensions.card-element-spacing;
            ErrorHeadingLabel {
                text: "What will be deleted";
            }

            ErrorLabel {
                text: "This removes the connection from SyncPak.";
            }

            ErrorLabel {
                text: "Its local folder and cloud files are not deleted.";
            }
        }
    }

    VerticalLayout {
        Button {
            accessible-label: "Keep connection " + root.connection-name;
            text: "Cancel";
            clicked => {
                root.cancel();
            }
        }

        Button {
            accessible-label: "Delete connection " + root.connection-name;
            text: "Delete " + root.connection-name;
            primary: true;
            clicked => {
                root.confirm();
            }
        }
    }
}

export component ActivityCancelPage inherits CenteredPageRoot {
    in property <string> activity-name;
    callback dismiss();
    callback confirm();
    HeadingLabel {
        text: "Cancel " + root.activity-name + "?";
        wrap: word-wrap;
    }

    DescriptionLabel {
        text: "Completed changes will not be undone. Work that has not started will be skipped.";
    }

    VerticalLayout {
        Button {
            accessible-label: "Keep " + root.activity-name + " running";
            text: "Keep running";
            clicked => {
                root.dismiss();
            }
        }

        Button {
            accessible-label: "Cancel operation " + root.activity-name;
            text: "Cancel " + root.activity-name;
            primary: true;
            clicked => {
                root.confirm();
            }
        }
    }
}
