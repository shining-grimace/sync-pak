import { Colors } from "../colors.slint";
import { Dimensions } from "../dimensions.slint";

export component ErrorHeadingLabel inherits Text {
    min-width: 0px;
    max-height: self.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    color: Colors.danger;
    font-size: Dimensions.text-size-section-header;
    font-weight: 700;
    wrap: word-wrap;
    horizontal-alignment: start;
}
